# Unity YAML系はテキストとして差分管理(Force Text推奨: ProjectSettings/EditorSettings.assetで設定)
*.unity text
*.prefab text
*.asset text
*.mat text
*.controller text
*.anim text
*.meta text

# ===== バイナリシリアライズされるUnityアセット =====
# TerrainDataはForce Text設定下でもバイナリ形式で保存されるため、
# 上のtext属性による改行コード変換(LF->CRLF)を受けるとヘッダーが破損し
# "Invalid serialized file header" エラーでUnityが読み込めなくなる。
*TerrainData*.asset -text
ProjectSettings/XRSettings.asset -text

# ===== Git LFSで管理するバイナリ資産 =====
# 3Dモデル
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text

# テクスチャ・画像
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# 音声
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# 動画
*.mp4 filter=lfs diff=lfs merge=lfs -text

# バイナリ .asset (Unity TerrainData 等) は eol 変換禁止 (2026-08-16: CRLF 変換で破損したため)
Assets/Stage/Terrain/ForestTerrainData.asset -text

# ===== LFS に載せないもの =====
# 検証用スクショは上の *.png ルールで LFS に流れ込み、アカウントの LFS 枠 10GB を
# 2.79GB (58%) 消費して 2026-09-06 に 90% 警告を受けた。GitHub は LFS オブジェクトを
# GC しないので、一度 push すると消せない。ここで filter を外し、万一 .gitignore を
# すり抜けて add されても LFS 枠を食わないようにする。
Assets/Screenshots/** -filter -diff -merge -text
ScreenshotsOut/** -filter -diff -merge -text
Assets/_Recovery/** -filter -diff -merge -text

# フックは sh スクリプト。CRLF になると Git Bash が
# "bad interpreter" で実行できなくなるので LF 固定。
.githooks/** text eol=lf
