// ============================================================================================
// FluidCore.compute -- Position Based Fluids, World Space, GPU.
//
// 設計書 FLUID_DESIGN.md の §2/§3/§6/§7/§8/§9/§10 に対応する。
//
// ORIGIN / LICENCE: first-party code, written from scratch. 参照したのは論文のアルゴリズムのみ
// (PBF: Macklin & Muller 2013 / Boundary handling + Surface tension: Akinci et al. 2012, 2013)。
// これらは公表されたアルゴリズムであってコード著作物ではないため、ライセンス義務は発生しない。
//
// 設計上ここで絶対に守っていること:
//  * 外力は World Gravity のみ。疑似重力 (-a_pot) は存在しない (§2)。容器の運動は
//    Moving Boundary が実際の運動量として伝える。
//  * 壁は Boundary Particle として密度計算に参加する = 圧力ソルバーの「内側」にいる (§10)。
//    位置クランプで壁を表現しない。
//  * SafetyCorrection は例外処理であり、その位置差は速度に変換しない (§10)。
// ============================================================================================

// 2026-08-21 ディスパッチ対策③: 相互依存のない軽量カーネルを結合して
// サブステップあたりのディスパッチ数 (=GPU バリア数) を減らした。
//   UpdateBoundary + Integrate        -> IntegrateAndBoundary
//   ClearCellCounts + BuildSortPositions -> ClearAndBuildSort
//   ComputeVelocity + ComputeNormals  -> VelocityAndNormals
// 計算内容は不変 (同じ式を同じ順序依存で実行する)。
#pragma kernel ClearAndBuildSort
#pragma kernel CountParticlesPerCell
#pragma kernel ScanLocal
#pragma kernel ScanBlockSums
#pragma kernel ScanAddOffsets
#pragma kernel ScatterParticles
#pragma kernel IntegrateAndBoundary
#pragma kernel ComputeDensityLambda
#pragma kernel ComputeDeltaP
#pragma kernel ApplyDeltaP
#pragma kernel VelocityAndNormals
#pragma kernel ApplyViscosityTension
#pragma kernel Finalize
#pragma kernel SolidBoxCollide
#pragma kernel ClassifyRegions
#pragma kernel TeleportFluid

#define THREADS 256
#define SCAN_BLOCK 256

#define REGION_INSIDE  0u

// ---------------------------------------------------------------------------- fluid state
//
// 読み取り専用の使い方をするバッファは SRV (StructuredBuffer) として別名で宣言してある。
// D3D11 の UAV スロット上限は 8 で、全部を RWStructuredBuffer にすると
// ApplyViscosityTension が 9 個使ってしまい「more uavs than supported」でカーネルごと
// 実行されない（＝粘性が一切効かず流体が発散する）。同じ GraphicsBuffer を、書くカーネルには
// RW 名で、読むカーネルには RO 名でバインドする。1 つのカーネルに両方を同時にバインドしない
// ことは C# 側の per-kernel バインドで保証する。
RWStructuredBuffer<float3> Positions;
// 分類カーネル用の読み取り専用エイリアス。
// RimOpening 判定が液体を押し出すことがコード上不可能になるよう、
// ClassifyRegions には位置・速度を SRV としてしかバインドしない (§11/追加修正1)。
StructuredBuffer<float3>   PositionsIn;
StructuredBuffer<float3>   VelocitiesIn;   // 分類カーネル用（CFL の実測最大速度を取るため）
RWStructuredBuffer<float3> PredictedPositions;
StructuredBuffer<float3>   PredictedIn;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float3> DeltaP;
StructuredBuffer<float3>   VelocityIn;        // = DeltaP（ComputeVelocity が新速度を置いた後）
RWStructuredBuffer<float3> Normals;
StructuredBuffer<float3>   NormalsIn;
RWStructuredBuffer<float3> SafetyCorrection;
RWStructuredBuffer<float>  Densities;
StructuredBuffer<float>    DensitiesIn;
RWStructuredBuffer<float>  Lambdas;
StructuredBuffer<float>    LambdasIn;

// ---------------------------------------------------------------------------- boundary
// 境界は「動く壁」。容器ローカルに固定された座標を、毎サブステップ World へ変換し直す。
// 速度は V_b = v_container + cross(omega_container, p_b - center) (§3)。
// これが Fluid への容器運動の唯一の伝達経路であり、疑似重力は存在しない (§2)。
StructuredBuffer<float3>   BoundaryLocal;
RWStructuredBuffer<float3> BoundaryPositionsRW;
RWStructuredBuffer<float3> BoundaryVelocitiesRW;
StructuredBuffer<float3>   BoundaryPositions;
StructuredBuffer<float3>   BoundaryVelocities;
StructuredBuffer<float>    BoundaryVolumes;

float4x4 BoundaryToWorld;
float3   ContainerLinearVelocity;
float3   ContainerAngularVelocity;
float3   ContainerCenter;
uint     BoundaryCount;

// ---------------------------------------------------------------------------- sorting
RWStructuredBuffer<float3> SortPositions;
StructuredBuffer<float3>   SortPositionsIn;
RWStructuredBuffer<uint>   CellCounts;
StructuredBuffer<uint>     CellCountsIn;
RWStructuredBuffer<uint>   CellStart;
StructuredBuffer<uint>     CellStartIn;
RWStructuredBuffer<uint>   CellCursor;
RWStructuredBuffer<uint>   BlockSums;
RWStructuredBuffer<uint>   SortedIndices;
StructuredBuffer<uint>     SortedIndicesIn;

// ---------------------------------------------------------------------------- uniforms
uint  FluidCount;
uint  TotalCount;          // FluidCount + BoundaryCount
uint  CellTotal;
uint  BlockCount;

float DeltaTime;
float3 Gravity;            // §2: Physics.gravity のみ

float KernelRadius;        // h
float RestDensity;         // rho0
float ParticleMass;        // m0
float RelaxationEps;
float MinDenom;            // lambda の分母の下限（自由表面の暴走を止める）
float BoundaryPressureScale;  // 境界からの圧力押し戻しの強さ（切り分け用に外出し）
// 位置補正の緩和係数 (SOR)。1 = 完全な Newton ステップ。
// これが無いと補正が毎反復で行き過ぎ、その位置差が v=(p'-p)/dt で速度に変わり、
// サブステップごとにエネルギーが注入されて流体が浮き上がる。実測: 反復 0 で完全静止
// (topY 0.425)、反復 1 で 1.197、反復 4 で 1.350 と反復数に比例して吹き上がった。
float SolverRelaxation;
float ArtificialPressure;
float ArtificialPressureQ;
float MaxDeltaP;           // 1反復あたりの位置補正上限

float ViscosityXSPH;
float ViscosityRefStep;    // 粘性係数の基準時間刻み。ブレンド率 = 係数 * dt / これ
float BoundaryViscosity;   // §2: 接線方向の運動量伝達。法線方向(圧力)とは直交する
float CohesionStrength;    // §9 Akinci
float CurvatureStrength;   // §9 Akinci
float MaxSpeed;
// 壺内ゲート限定のクランプ (2026-08-16)。通常は MaxSpeed と同値。おろし/拾い/熱い床
// ジャンプ中だけ CPU 側が絞る。壺外 (落下中の液滴・地面の水たまり) は MaxSpeed のままに
// することで、「こぼれた液体がスローモーションで落ちる」のを防ぐ。
float MaxSpeedPot;
// 2026-08-22: 壺外専用のクランプ。落下する液滴の終端速度に相当する。MaxSpeed (5) のままだと
// 高所からのこぼれが不自然に遅く落ちる。地面バンドのトンネリング防止条件
// (v * sdt < GroundBandHeight) を満たす範囲で上げる。
float MaxSpeedFalling;
float EscapedIgnoreCalm;   // 追補 33: 1 = 脱出済み液滴に calm を掛けない
// 追補 26: パリー成功の「回収」— 壺の近くではみ出している粒子を口へ引き戻す。
// RecallStrength > 0 の間だけ有効。RecallTarget は壺の口の少し上 (world)。
float RecallStrength;
float3 RecallTarget;
float RecallMinY;      // これより低い粒子 (地面の水たまり) は回収しない
float RecallRadius;    // 回収の届く距離 (m)
float SpillGrace;      // 1 の間はこぼれを地面で凍結させない (拾い直せる状態で置く)
// 追補 26: パリーなし着地のジョルト — 壺内の粒子へ 1 フレームかけて速度を注入し、
// 着地の「ドスン」を流体に伝える (加速度として渡す: dv / frameDt)。
// 縦成分だけだと噴水が壺内へ落ち戻るので、前方成分を混ぜてリムを越えさせる。
float3 JoltAccel;

float3 GridOrigin;
float  CellSize;
uint3  GridSize;

float3 BoundsMin;
float3 BoundsMax;
float  BoundsRestitution;
float  BoundsFriction;

// ---- SafetyCorrection (§10) ----
// 通常時の壁は Boundary Particles + PBF + CFL が担当する。これは「数値的不安定や
// 極端な一時貫通」だけを拾う最終安全装置であり、常態化したら破綻とみなす指標を出す。
// 補正は ComputeVelocity より後（Finalize）で行うため、構造的に速度へ変換されない。
StructuredBuffer<float> PotProfileBuf;
// 壺の **外形**（高さビンごとの最大半径）。PotMeshMinY..PotMeshMaxY を等分。
// 「壺の実体がどこまであるか」を知るために要る。これが無いと、こぼれた液体が
// 壺の胴や底を素通りして落ちていき、ジャンプ時に壺の下から液体が湧いて見える。
StructuredBuffer<float> PotOuterBuf;
uint   PotProfileCount;
float  PotFloorY;
float  PotRimY;
float  PotMeshMinY;
float  PotMeshMaxY;
float  SafetyTopY;   // ここより上では SafetyCorrection を一切かけない（リムは出口であって壁ではない）
float  PotMaxRadius;
float  PotRimR;            // リム半径。Rim Opening 領域の判定に使う
float  SafetyMargin;
int    SafetyEnabled;
float4x4 WorldToPotSafety;
float4x4 PotToWorldSafety;
RWStructuredBuffer<uint> SafetyCounters;   // [0] = 発動粒子数

// ---- ギミックの箱コライダ (2026-08-15) ----
// バグ報告「ギミックのブロックにこぼれたポーションがつかず、貫通して地面まで落ちる」。
// 流体の衝突相手は境界粒子(壺)・地面平面(GroundY)・領域外周だけで、ステージの箱は
// シミュレーションに存在しなかった。GroundSurface 付きの BoxCollider を FluidCore.cs が
// 集めて渡し、Finalize で押し出す。上面に着いた Escaped 粒子はその場で水たまりとして
// 定着する（地面と同じ扱い = Ground 集計・寿命 GroundLifetime で消える）。
uint SolidBoxCount;
StructuredBuffer<float4x4> SolidBoxWorldToLocal;   // 回転 + 平行移動のみ（スケールは half extents 側に畳んである）
StructuredBuffer<float4x4> SolidBoxLocalToWorld;
StructuredBuffer<float4> SolidBoxHalf;             // xyz = half extents (粒子半径込み), w = 1 で上面定着可（動く床は 0）

// ---- 領域分類 / Overflow 判定 (§11, §14) ----
// ここは「観測」しかしない。粒子の生成も移動も速度変更も一切行わない。
RWStructuredBuffer<uint> RegionFlags;
RWStructuredBuffer<uint> RegionCounters;
// [0]=Inside [1]=RimOpening [2]=Airborne [3]=Ground [4]=Retired
// [5]=正常Overflow遷移 [6]=貫通(異常) [7]=流体の最大速さ（固定小数 x1000）
//
// Retired (§16/§20): 地面に一定時間留まった粒子は「ゲーム世界から消滅した」扱いになる。
// 消滅の実行は Finalize が行い（位置を動かすのは物理カーネルの仕事）、
// ここでは観測して数えるだけ。
RWStructuredBuffer<float> Ages;            // 地面に留まっている時間 (s)
// 0 = 通常, 1 = Retired（世界から消滅・回収不可）, 2 = Settled（地面に取り残された水たまり）
//
// Settled: 地面に落ちた液体は、ゴブリンが歩いて計算領域が離れても
// **その場に残っていてほしい**。領域の外へ出た地面の液体は、消すのではなく
// その場で凍結する。位置はそのままなので、戻ってくれば再び描画される。
// Mass の扱いは Ground のまま（§16 で「将来的に回収可能」な分類）。
// 0 = 通常 / 1 = Retired / 2 = Settled / 3 = Escaped
//
// Escaped: **壺のふちを越えた液体**。一度越えたら壺へは戻らず、そのまま地面へ落ちる。
// 越えた液体が跳ね上がって壺の口へ落ち戻ると、見た目には派手にこぼれているのに
// 残量が減らない（実測: 揺さぶりで空中へ出た 8708 粒子のうち 2329 しか地面に残らず、
// PotionVolume が 0.917 までしか下がらなかった）。
// Escaped は壁とも他の粒子とも相互作用しない。重力と地面 Collision だけが効く。
RWStructuredBuffer<uint>  RetiredFlags;
StructuredBuffer<uint>    RetiredFlagsIn;  // 読み取り専用エイリアス
float EscapeMargin;      // リム面からこの高さ(local)を超えたら Escaped
// 壺の外形からこの距離(local)以上離れたら、姿勢に関係なく Escaped。
// 壁の貫通 (壁厚の内側) と区別できるだけの余裕を取ること。
float EscapeFarMargin;
int   EscapeEnabled;
float  GroundLifetime;                     // これを超えたら Retired
float3 RetiredPark;                        // Retired 粒子の待避先（領域外）
float RimOpeningHeight;
float GroundY;
float GroundBandHeight;   // 地面から上へこの高さまでを Ground 領域とみなす (§20)
// 壁際の粒子は中心が R(y) をわずかに超えた位置で静止しうる。これを「壁抜け」と
// 数えないための許容幅（local 単位、粒子半径程度）。
float WallTolerance;
// 床より下をどこまで「まだ壺の中」とみなすか。着地の衝撃で沈む分の許容。
float FloorTolerance;

// ---- Terrain-hugging slope collision (滝専用、既定は無効) ----
// GroundYは平らな1枚の面だが、滝(PotionWaterfallFluid)は崖の傾斜に沿って岩に
// ぶつかりながら落ちる必要がある。SlopeProfileBufが未設定(要素2、両方GroundYと
// 同値)のときはSlopeHeightAtが常にGroundYを返すため、下のFinalizeの分岐は
// 従来の平らなGroundY判定と完全に同じ結果になる(＝壺の運搬物理には無条件で
// 影響しない、C#側でフラグを別途持つ必要がない)。
StructuredBuffer<float> SlopeProfileBuf;   // 崖断面の実測高さ(Z方向に等間隔サンプル)
uint  SlopeProfileCount;
float SlopeZStart;      // profile[0]に対応するワールドZ(池側、より手前)
float SlopeZEnd;        // profile[count-1]に対応するワールドZ(水源側、より奥)
float SlopeRestitution; // 斜面接触専用の反発係数(GroundのBoundsRestitutionより弾む)
float SlopeFriction;    // 斜面接触専用の摩擦(下向きの勢いを殺さないよう弱め)
uint  FrameSeed;        // 斜面接触点の表面ジッター用(フレームごとに変える、粒子ごとのハッシュ種)

// ---- Waterfall Recycle (滝専用。SpawnBoxSizeが実質ゼロなら従来通りRetiredParkへ待避する
// だけで、壺の運搬物理には影響しない) ----
// 壺版はRetired粒子をRetiredPark(領域外)へ駐め置いて終わりだが、滝は水源が要るので、
// 代わりに水源付近の箱内へランダム再配置して再び流し始め、少ない粒子予算で
// 「途切れず流れ続ける川」に見せる。
float3 SpawnBoxMin;
float3 SpawnBoxSize;    // 各成分が実質0なら無効(既定)。0でなければそのボックス内へ再配置する。
float3 SpawnVelocity;
// 1フレームに再配置してよい割合 (0..1)。滝は 1 (=従来どおり全部すぐ戻す)。
// 壺の補充では「口から流れ込む」量に相当させたいので、ここを絞って毎フレーム少しずつ戻す。
// 1 未満だと Retired の在庫が一気に復活せず、実際に注がれているように増えていく。
float SpawnChance;

// ============================================================================ SPH kernels
static const float PI = 3.14159265359;

float Poly6(float r2, float h)
{
    float h2 = h * h;
    if (r2 >= h2) return 0.0;
    float d = h2 - r2;
    float h9 = h2 * h2 * h2 * h2 * h;
    return 315.0 / (64.0 * PI * h9) * d * d * d;
}

float3 SpikyGrad(float3 rij, float h)
{
    float r = length(rij);
    if (r >= h || r < 1e-7) return float3(0, 0, 0);
    float h6 = h * h * h * h * h * h;
    float d = h - r;
    return rij * (-45.0 / (PI * h6) * d * d / r);
}

// Akinci et al. 2013 の cohesion スプライン。h で 0 に落ちる。
float CohesionKernel(float r, float h)
{
    if (r <= 0.0 || r >= h) return 0.0;
    float c = 32.0 / (PI * pow(h, 9));
    float hr = h - r;
    if (r > h * 0.5) return c * hr * hr * hr * r * r * r;
    return c * (2.0 * hr * hr * hr * r * r * r - pow(h, 6) / 64.0);
}

// ============================================================================ grid helpers
int3 CellCoord(float3 p) { return (int3)floor((p - GridOrigin) / CellSize); }
bool CellValid(int3 c) { return all(c >= 0) && all((uint3)c < GridSize); }
uint CellIndex(int3 c) { return (uint)c.x + (uint)c.y * GridSize.x + (uint)c.z * GridSize.x * GridSize.y; }

// ============================================================================ teleport (§21)
// 容器が瞬間移動したときに、中身を同じ剛体変換で連れて行く。
// 相対速度は与えない（速度はワールドの回転ぶんだけ向きを変える）。
float4x4 TeleportMatrix;
StructuredBuffer<uint> RegionFlagsIn;   // 前フレームの領域分類（読み取り専用）

[numthreads(THREADS, 1, 1)]
void TeleportFluid(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;

    // **壺の中身だけを運ぶ。** こぼれて地面にある液体や落下中の液体まで一緒に運ぶと、
    // 容器が速く動いたときに水たまりが壺に付いてきてしまい、
    // 「こぼれた分だけ残量が減る」が成立しなくなる
    // （実測: よろけで PotionVolume が 0.964 -> 0.992 と増えた）。
    if ((RegionFlagsIn[i] & 7u) != REGION_INSIDE) return;

    Positions[i] = mul(TeleportMatrix, float4(Positions[i], 1.0)).xyz;
    Velocities[i] = mul((float3x3)TeleportMatrix, Velocities[i]);
}

// ============================================================================ sorting passes
// セルカウンタのクリアとソート座標の構築。互いに独立なのでスレッド範囲の分岐で 1 回の
// ディスパッチにまとめる (2026-08-21 結合)。max(CellTotal, TotalCount) スレッドで呼ぶこと。
// 流体は予測位置、境界は World 位置を探索座標にする。
[numthreads(THREADS, 1, 1)]
void ClearAndBuildSort(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i < CellTotal) CellCounts[i] = 0;
    if (i < TotalCount)
        SortPositions[i] = (i < FluidCount) ? PredictedPositions[i] : BoundaryPositions[i - FluidCount];
}

[numthreads(THREADS, 1, 1)]
void CountParticlesPerCell(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= TotalCount) return;
    if (i < FluidCount && RetiredFlagsIn[i] != 0u) return;   // Escaped/Settled/Retired は近傍に入らない
    int3 c = CellCoord(SortPositions[i]);
    if (!CellValid(c)) return;
    uint dummy;
    InterlockedAdd(CellCounts[CellIndex(c)], 1, dummy);
}

// 3段スキャン: ブロック内排他スキャン -> ブロック合計のスキャン -> ブロックオフセット加算。
// カウンティングソートを採用した理由は §7 の設計注記を参照（セル毎の粒子数に上限を作らない
// 完全ソートであることが要件。Bitonic だと 105 ディスパッチ必要で、これは 4 で済む）。
groupshared uint gScan[SCAN_BLOCK];

[numthreads(SCAN_BLOCK, 1, 1)]
void ScanLocal(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
    uint i = id.x;
    uint t = tid.x;
    gScan[t] = (i < CellTotal) ? CellCounts[i] : 0;
    GroupMemoryBarrierWithGroupSync();

    // Hillis-Steele inclusive scan
    [unroll] for (uint offset = 1; offset < SCAN_BLOCK; offset <<= 1)
    {
        uint v = (t >= offset) ? gScan[t - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gScan[t] += v;
        GroupMemoryBarrierWithGroupSync();
    }

    uint inclusive = gScan[t];
    if (i < CellTotal) CellStart[i] = inclusive - ((i < CellTotal) ? CellCounts[i] : 0); // exclusive
    if (t == SCAN_BLOCK - 1) BlockSums[gid.x] = inclusive;
}

[numthreads(1024, 1, 1)]
void ScanBlockSums(uint3 tid : SV_GroupThreadID)
{
    // ブロック和の排他プレフィックス。旧実装はスレッド 0 の逐次ループ (BlockCount 回転、
    // セル 44 万で ~1700 回転) で、サブステップ毎に GPU を直列ストールさせていた。
    // SCAN_BLOCK 要素ずつの並列スキャンに置き換え (2026-08-21)。結果は旧実装と同一。
    // チャンク合計 (gScan の末尾) は全スレッドがバリア後に同じ値を読むので uniform。
    uint t = tid.x;
    // ストリップ分割 3 フェーズ。バリアはユニフォームな流れの中に固定 2 回だけ
    // (動的ループ内バリアはドライバによって壊れることがあるため使わない)。
    // 逐次の深さ: 旧 BlockCount (~1700) → stripLen (~7) + SCAN_BLOCK (256)。
    uint stripLen = (BlockCount + SCAN_BLOCK - 1) / SCAN_BLOCK;
    uint start = t * stripLen;

    // phase 1: 各スレッドが担当ストリップの合計を出す
    uint sum = 0;
    for (uint k = 0; k < stripLen; k++)
    {
        uint idx = start + k;
        if (idx < BlockCount) sum += BlockSums[idx];
    }
    gScan[t] = sum;
    GroupMemoryBarrierWithGroupSync();

    // phase 2: ストリップ合計の排他スキャン (スレッド 0 の逐次、SCAN_BLOCK 回転のみ)
    if (t == 0)
    {
        uint acc = 0;
        for (uint s = 0; s < SCAN_BLOCK; s++)
        {
            uint c = gScan[s];
            gScan[s] = acc;
            acc += c;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // phase 3: 各ストリップ内を排他値で書き戻す
    uint acc2 = gScan[t];
    for (uint k2 = 0; k2 < stripLen; k2++)
    {
        uint idx2 = start + k2;
        if (idx2 < BlockCount)
        {
            uint c2 = BlockSums[idx2];
            BlockSums[idx2] = acc2;
            acc2 += c2;
        }
    }
}

[numthreads(THREADS, 1, 1)]
void ScanAddOffsets(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID)
{
    uint i = id.x;
    if (i >= CellTotal) return;
    uint off = BlockSums[i / SCAN_BLOCK];
    CellStart[i] += off;
    CellCursor[i] = CellStart[i];
}

[numthreads(THREADS, 1, 1)]
void ScatterParticles(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= TotalCount) return;
    if (i < FluidCount && RetiredFlagsIn[i] != 0u) return;   // 近傍リストに入れない
    int3 c = CellCoord(SortPositions[i]);
    if (!CellValid(c)) return;
    uint slot;
    InterlockedAdd(CellCursor[CellIndex(c)], 1, slot);
    SortedIndices[slot] = i;
}

// ---- 速度クランプの基準速度 (2026-08-15 改定) ----
// MaxSpeed の目的は「壺に対する」跳ね上がり高さの制限 (v^2/2g、宣言部の注記) であって、
// 壺ごと自由落下する液体を世界基準で制限することではない。世界基準のままだと、
// 上り勾配の頂上から落ちるとき (容器 9.1 m/s > MaxSpeed 5) に中身が追従できず、
// 相対的に浮き上がって 4000 粒超の孤立液滴の雲になる (実測 4151 粒)。孤立液滴は
// 1 粒あたり約 167 三角形を生む (FluidSurface.cs の実測コメント) ので、これが
// 「落下すると描画が一気にかくかくになる」の正体だった。
//
// 壺の中とその近傍にいる粒子だけ容器の並進速度を基準にし、壺の外 (地面の水たまり、
// こぼれて落下中の液滴) は従来どおり世界基準にする。外まで容器基準にすると、容器が
// 速く動くたびに静止した水たまりが引きずられてしまう。ゲートはプロファイルバッファに
// 依存しない円筒近似 (半径 1.5 倍・上下に余裕) — Integrate には PotProfileBuf が
// 束縛されていないので、ここでプロファイルを読んではいけない。
bool InPotGate(float3 worldPos)
{
    if (SafetyEnabled == 0) return false;
    float3 pl = mul(WorldToPotSafety, float4(worldPos, 1.0)).xyz;
    float span = max(PotRimY - PotFloorY, 1e-3);
    return pl.y > PotMeshMinY - 0.5 * span && pl.y < PotRimY + span &&
           dot(pl.xz, pl.xz) < PotMaxRadius * PotMaxRadius * 2.25;
}

float3 SpeedClampRef(float3 worldPos)
{
    return InPotGate(worldPos) ? ContainerLinearVelocity : float3(0, 0, 0);
}

// 追補 33 (2026-08-22 バグ報告「こぼれたポーションの落ち方がスローモーション」/
//          「前方に歩いたときの不思議なこぼれ」の真因):
// InPotGate は壺の外形の **1.5 倍半径・上下にも 1 span 分** という非常に緩い判定なので、
// リムを越えてこぼれた液滴はしばらくこのゲートの中に残る。従来はそのゲートだけで
// クランプ先を決めていたため、こぼれた直後の液滴が **calm 中の MaxSpeedPot
// (歩行 1.0 / 傾斜ランプ 0.5 m/s)** で頭を押さえられていた。
// 結果、壺の縁から溢れた液体が 1 m/s 前後でゆっくり垂れ下がり (自由落下なら 0.3 秒で
// 3 m/s)、壺から離れた瞬間に急に加速する。これが「蜜の中を落ちる」「壺の周りに
// 液体がまとわりつく不思議なこぼれ方」の正体だった。歩行・旋回・走行にも calm を
// 広げた追補 30 以降はほぼ常時発火していた。
// 脱出済み (RetiredFlags != 0) の粒子は、位置がどこであろうと世界基準 +
// MaxSpeedFalling で落とす。calm は「壺の中身を落ち着かせる」ためのものであって、
// もう壺の外にある液体には掛けてはいけない。
float3 ClampSpeedFor(float3 v, float3 worldPos, uint retired)
{
    // 壺内は容器基準 + MaxSpeedPot、壺外は世界基準 + MaxSpeedFalling。
    // calm (MaxSpeedPot を絞る) の間も、こぼれた液滴は通常速度で落ちる。
    // 2026-08-22: 壺外の上限を MaxSpeed (5) から分離。橋の上 (8m) からのこぼれが
    // 5 m/s (本来 18 m/s) で落ちて「蜜の中を落ちる」スローモーションに見えていた。
    bool escapedFree = (retired != 0u) && (EscapedIgnoreCalm > 0.5);
    bool gated = !escapedFree && InPotGate(worldPos);
    float3 vref = gated ? ContainerLinearVelocity : float3(0, 0, 0);
    float lim = gated ? MaxSpeedPot : MaxSpeedFalling;
    float3 rel = v - vref;
    float sp = length(rel);
    if (sp > lim) rel *= lim / sp;
    return vref + rel;
}

// 壺の中身専用の呼び出し口 (脱出粒子が混ざらない経路から使う)。
float3 ClampSpeed(float3 v, float3 worldPos) { return ClampSpeedFor(v, worldPos, 0u); }

// ============================================================================ PBF
// §2: 外力は World Gravity のみ。
// 動く境界の更新 (旧 UpdateBoundary) を結合済み (2026-08-21)。境界粒子の配置と流体の
// 時間積分は互いに独立なので、max(FluidCount, BoundaryCount) スレッドの 1 ディスパッチで
// 両方を行う。
[numthreads(THREADS, 1, 1)]
void IntegrateAndBoundary(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i < BoundaryCount)
    {
        float3 w = mul(BoundaryToWorld, float4(BoundaryLocal[i], 1.0)).xyz;
        BoundaryPositionsRW[i] = w;
        BoundaryVelocitiesRW[i] = ContainerLinearVelocity
                                + cross(ContainerAngularVelocity, w - ContainerCenter);
    }
    if (i >= FluidCount) return;

    float3 v = Velocities[i] + Gravity * DeltaTime;

    // 追補 26a: パリー回収。壺の近傍 (2.6m) で、壺の外にいて、地面の水たまりでない
    // 粒子を口の上へ吸い寄せる。速度を目標方向 7 m/s へ指数追従させる。
    if (RecallStrength > 0.001)
    {
        float3 p = Positions[i];
        float3 toT = RecallTarget - p;
        float d = length(toT);
        if (d < RecallRadius && p.y > RecallMinY && !InPotGate(p))
        {
            float3 dir = toT / max(d, 0.001);
            v = lerp(v, dir * 7.0, saturate(RecallStrength * DeltaTime));
        }
    }
    // 追補 26b: パリーなし着地のジョルト (壺内のみ)
    if (dot(JoltAccel, JoltAccel) > 0.001 && InPotGate(Positions[i]))
        v += JoltAccel * DeltaTime;

    // 追補 33: 脱出済みの液滴には calm (MaxSpeedPot) を掛けない。
    v = ClampSpeedFor(v, Positions[i], RetiredFlagsIn[i]);

    Velocities[i] = v;
    PredictedPositions[i] = Positions[i] + v * DeltaTime;
    SafetyCorrection[i] = float3(0, 0, 0);
}

// 近傍走査マクロ。流体・境界を区別せず 3x3x3 セルを回る。
#define FOREACH_NEIGHBOUR(centre, body)                                            \
{                                                                                  \
    int3 _base = CellCoord(centre);                                                \
    [loop] for (int _dz = -1; _dz <= 1; _dz++)                                     \
    [loop] for (int _dy = -1; _dy <= 1; _dy++)                                     \
    [loop] for (int _dx = -1; _dx <= 1; _dx++)                                     \
    {                                                                              \
        int3 _c = _base + int3(_dx, _dy, _dz);                                     \
        if (!CellValid(_c)) continue;                                              \
        uint _ci = CellIndex(_c);                                                  \
        uint _s = CellStartIn[_ci];                                                  \
        uint _e = _s + CellCountsIn[_ci];                                            \
        [loop] for (uint _k = _s; _k < _e; _k++)                                   \
        {                                                                          \
            uint j = SortedIndicesIn[_k];                                            \
            body                                                                   \
        }                                                                          \
    }                                                                              \
}

[numthreads(THREADS, 1, 1)]
void ComputeDensityLambda(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;
    // 壺を出た液体は他と相互作用しない。重力で落ちるだけ。
    if (RetiredFlagsIn[i] != 0u) { Densities[i] = RestDensity; Lambdas[i] = 0.0; return; }

    float h = KernelRadius;
    float3 pi = PredictedPositions[i];

    float rho = ParticleMass * Poly6(0.0, h);
    float3 gradSelf = float3(0, 0, 0);
    float sumGradSq = 0.0;

    FOREACH_NEIGHBOUR(pi,
    {
        if (j == i) continue;
        bool isBoundary = (j >= FluidCount);
        float3 pj = SortPositionsIn[j];
        float3 rij = pi - pj;
        float r2 = dot(rij, rij);
        if (r2 >= h * h) continue;

        if (isBoundary)
        {
            // Akinci 境界: 質量ではなく体積 psi で密度に寄与する。
            float psi = RestDensity * BoundaryVolumes[j - FluidCount];
            rho += psi * Poly6(r2, h);
            float3 g = psi * SpikyGrad(rij, h) / RestDensity;
            gradSelf += g;
            sumGradSq += dot(g, g);
        }
        else
        {
            rho += ParticleMass * Poly6(r2, h);
            float3 g = ParticleMass * SpikyGrad(rij, h) / RestDensity;
            gradSelf += g;
            sumGradSq += dot(g, g);   // 隣接側の勾配（境界は動かないので寄与しない）
        }
    })

    Densities[i] = rho;

    // 圧縮のみ拘束する。自由表面の粒子は近傍が少なく密度が低いのが正常であり、
    // これを負の拘束にすると表面を内側へ吸い込んで粒状化する。
    float C = max(0.0, rho / RestDensity - 1.0);
    sumGradSq += dot(gradSelf, gradSelf);

    // 分母に下限を入れる。自由表面の粒子は近傍が少ないので sum|gradC|^2 が小さく、
    // lambda = -C / sum|gradC|^2 が桁違いに大きくなって表面の粒子だけが射出される。
    // 実測: 反復 0 で完全静止 (topY 0.425) だったものが、反復 1 で 1.197、反復 4 で 1.350 と
    // 反復数に比例して吹き上がった。エネルギーを注入していたのはこの項。
    float denom = max(sumGradSq, MinDenom) + RelaxationEps;
    Lambdas[i] = -C / denom;
}

[numthreads(THREADS, 1, 1)]
void ComputeDeltaP(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;
    if (RetiredFlagsIn[i] != 0u) { DeltaP[i] = float3(0, 0, 0); return; }

    float h = KernelRadius;
    float3 pi = PredictedPositions[i];
    float li = LambdasIn[i];
    float wq = Poly6(ArtificialPressureQ * h * ArtificialPressureQ * h, h);
    float3 dp = float3(0, 0, 0);

    FOREACH_NEIGHBOUR(pi,
    {
        if (j == i) continue;
        float3 pj = SortPositionsIn[j];
        float3 rij = pi - pj;
        float r2 = dot(rij, rij);
        if (r2 >= h * h) continue;

        if (j >= FluidCount)
        {
            float psi = RestDensity * BoundaryVolumes[j - FluidCount];
            dp += BoundaryPressureScale * psi * li * SpikyGrad(rij, h);
        }
        else
        {
            float corr = 0.0;
            if (ArtificialPressure > 0.0 && wq > 1e-12)
            {
                float ratio = Poly6(r2, h) / wq;
                corr = -ArtificialPressure * ratio * ratio * ratio * ratio;
            }
            dp += ParticleMass * (li + LambdasIn[j] + corr) * SpikyGrad(rij, h);
        }
    })

    dp *= SolverRelaxation / RestDensity;

    // 1反復の移動量に上限。単一の大きな λ が粒子を壁の向こうへ飛ばすのを防ぐ。
    float len = length(dp);
    if (len > MaxDeltaP) dp *= MaxDeltaP / len;
    DeltaP[i] = dp;
}

[numthreads(THREADS, 1, 1)]
void ApplyDeltaP(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;
    PredictedPositions[i] += DeltaP[i];
}

// §10: SafetyCorrection の位置差は速度に変換しない。
// 速度確定 (旧 ComputeVelocity) と Akinci 表面張力用の法線 (旧 ComputeNormals) を結合
// (2026-08-21)。法線は速度に依存しない (predicted と密度のみ) ため相互依存が無い。
// 注: 法線側の位置は PredictedIn ではなく PredictedPositions を読む。同一バッファを
// 同一カーネルへ UAV (速度式) と SRV の両方で束縛することはできないため。値は同じ。
[numthreads(THREADS, 1, 1)]
void VelocityAndNormals(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;
    DeltaP[i] = (PredictedPositions[i] - Positions[i] - SafetyCorrection[i]) / max(DeltaTime, 1e-6);

    // Akinci 表面張力用の法線。目的は粒子の球体化ではなく表面の平滑化 (§9)。
    if (RetiredFlagsIn[i] != 0u) { Normals[i] = float3(0, 0, 0); return; }

    float h = KernelRadius;
    float3 pi = PredictedPositions[i];
    float3 n = float3(0, 0, 0);

    FOREACH_NEIGHBOUR(pi,
    {
        if (j == i || j >= FluidCount) continue;
        // 読み取り専用エイリアスを使う。RW 版 (SortPositions) を書くと、
        // このカーネルには束縛されていないため未束縛バッファを読んでしまう。
        float3 rij = pi - SortPositionsIn[j];
        float r2 = dot(rij, rij);
        if (r2 >= h * h) continue;
        n += (ParticleMass / max(DensitiesIn[j], 1e-6)) * SpikyGrad(rij, h);
    })

    Normals[i] = n * h;
}

[numthreads(THREADS, 1, 1)]
void ApplyViscosityTension(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;
    // Escaped/Settled/Retired は近傍計算をしない。ただし **速度の書き戻しは必要**。
    // ここで return してしまうと Velocities が更新されず、重力が乗らないまま
    // 脱出時の速度で飛び続ける（実測: 空中の液体が落ちてこず Ground が 0 のまま）。
    if (RetiredFlagsIn[i] != 0u) { Velocities[i] = VelocityIn[i]; return; }

    float h = KernelRadius;
    float3 pi = PredictedIn[i];
    float3 vi = VelocityIn[i];          // ComputeVelocity が置いた新速度
    float3 ni = NormalsIn[i];

    float3 xsph = float3(0, 0, 0);
    float3 boundaryDrag = float3(0, 0, 0);
    float3 tensionAccel = float3(0, 0, 0);   // 力ではなく加速度として積む（下の注記参照）
    float rhoI = max(DensitiesIn[i], 1e-9);

    FOREACH_NEIGHBOUR(pi,
    {
        if (j == i) continue;
        float3 pj = SortPositionsIn[j];
        float3 rij = pi - pj;
        float r2 = dot(rij, rij);
        if (r2 >= h * h) continue;
        float r = sqrt(max(r2, 1e-12));

        if (j >= FluidCount)
        {
            // §2 の補正項: 境界粘性。圧力結合が伝えるのは法線成分、これは接線成分。
            // 直交する独立成分なので疑似重力のような二重計上にならない。
            //
            // **接線成分だけに射影すること。** 相対速度をそのまま使うと、壁は「壁から
            // 離れていく動き」まで減速する。これは圧力（法線）と二重計上であり、
            // 実測では壺のリムを越えようとする薄い流出層を壁に貼り付けてしまい、
            // 液体が溢れ出せなくなった（Phase 7: bv=0.55 で残存 90.5%、bv=0 で 77.4%）。
            // rij は境界粒子から流体粒子への向きなので、局所法線の近似として使える。
            float psi = BoundaryVolumes[j - FluidCount];
            float w = Poly6(r2, h);
            float3 nb = rij / r;
            float3 dv = BoundaryVelocities[j - FluidCount] - vi;
            boundaryDrag += psi * w * (dv - dot(dv, nb) * nb);
        }
        else
        {
            float w = Poly6(r2, h);
            xsph += (ParticleMass / max(DensitiesIn[j], 1e-6)) * w * (VelocityIn[j] - vi);

            // Akinci 表面張力。ここは質量の扱いを間違えると即座に発散する:
            //   cohesion  F = -g m_i m_j C(r) r_hat   ->  加速度は -g m_j C(r) r_hat
            //   curvature F = -g m_i (n_i - n_j)      ->  加速度は -g (n_i - n_j)
            // つまり curvature には m_j が付かない。最初の実装は両方を「力」として足してから
            // 一括で m で割っており、curvature だけが 1/m (= 30000 倍) されて加速度が
            // 9000 m/s^2 に達し、1 秒で全粒子が NaN になった。
            float3 dir = rij / r;
            float kij = 2.0 * RestDensity / (rhoI + max(DensitiesIn[j], 1e-9));
            tensionAccel -= kij * CohesionStrength * ParticleMass * CohesionKernel(r, h) * dir;
            tensionAccel -= kij * CurvatureStrength * (ni - NormalsIn[j]);
        }
    })

    // 表面張力の加速度に上限を設ける。数値的な暴走をここで止め、下流の位置に NaN を
    // 伝播させない（NaN は一度出ると全粒子へ伝染して復帰不能になる）。
    float ta = length(tensionAccel);
    float taMax = 50.0;
    if (ta > taMax) tensionAccel *= taMax / ta;

    // 粘性は「周囲の速度へ何%寄せるか」というブレンドなので、そのままだと
    // **適用回数（サブステップ数）に比例して効きが変わる**。サブステップ数は CFL で
    // 2〜10 の間を動くため、容器を速く動かすほど中身が粘る、という物理的にあり得ない
    // 挙動になっていた。さらに 10 サブステップでは壁際の速度が 1 フレームで
    // 0.45^10 ≒ 0.0003 倍になり、リムを越える流出層（厚み ≒ h）ごと壁に貼り付いて
    // 液体が溢れ出せなかった（Phase 7 実測: 62°で残存 90%、液面が最低リム点より +0.153m）。
    //
    // ブレンド率を dt に比例させ、1 フレームあたりの粘性の総量をサブステップ数から
    // 独立させる。表面張力が加速度として dt を掛けているのと同じ扱いに揃える。
    float tscale = DeltaTime / max(ViscosityRefStep, 1e-6);
    float kVisc = min(ViscosityXSPH * tscale, 0.9);      // 1 を超えると行き過ぎて発散する
    float kBnd  = min(BoundaryViscosity * tscale, 0.9);

    float3 v = vi + kVisc * xsph + kBnd * boundaryDrag + tensionAccel * DeltaTime;

    if (any(isnan(v)) || any(isinf(v))) v = float3(0, 0, 0);
    v = ClampSpeed(v, pi);   // 容器基準の相対クランプ (SpeedClampRef の注記を参照)
    Velocities[i] = v;
}

bool SpawnBoxActive()
{
    return SpawnBoxSize.x > 1e-5 || SpawnBoxSize.y > 1e-5 || SpawnBoxSize.z > 1e-5;
}

float SlopeHeightAt(float worldZ)
{
    float u = saturate((SlopeZStart - worldZ) / max(1e-5, SlopeZStart - SlopeZEnd));
    float f = u * (float)(SlopeProfileCount - 1);
    uint i0 = (uint)floor(f);
    uint i1 = min(i0 + 1, SlopeProfileCount - 1);
    return lerp(SlopeProfileBuf[i0], SlopeProfileBuf[i1], saturate(f - (float)i0));
}

float PotRadiusAt(float localY)
{
    float u = saturate((localY - PotFloorY) / max(1e-5, PotRimY - PotFloorY));
    float f = u * (float)(PotProfileCount - 1);
    uint i0 = (uint)floor(f);
    uint i1 = min(i0 + 1, PotProfileCount - 1);
    return lerp(PotProfileBuf[i0], PotProfileBuf[i1], saturate(f - (float)i0));
}

// 壺の実体の外周半径。範囲外は端の値で伸ばす（壺より上には実体が無いので、
// リムの外周をそのまま使えば「壺の真上」を正しく外側と判定できる）。
float PotOuterAt(float localY)
{
    float u = saturate((localY - PotMeshMinY) / max(1e-5, PotMeshMaxY - PotMeshMinY));
    float f = u * (float)(PotProfileCount - 1);
    uint i0 = (uint)f;
    uint i1 = min(i0 + 1, PotProfileCount - 1);
    return lerp(PotOuterBuf[i0], PotOuterBuf[i1], saturate(f - (float)i0));
}

// ギミックの箱との衝突解決（宣言部の SolidBox* の注記を参照）。
// 戻り値: 0 = 接触なし / 1 = 接触して押し出した / 2 = 定着可能な上面に接触した。
// 最小貫通軸で押し出す単純な OBB 押し出し。箱は厚み 0.6m あり、外の粒子の速度は
// MaxSpeed=5 m/s・サブステップ刻みなので 1 ステップの移動は箱の厚みより十分小さく、
// トンネリングは起きない。
// 注記: StructuredBuffer の行列を式の中で直接 (float3x3) キャストしたり添字のまま
// mul に渡すと FXC が落ちる (実測: "Lost connection with shader compiler process")。
// 必ずローカルへコピーしてから使うこと。
uint ResolveSolidBoxes(inout float3 p, inout float3 v)
{
    uint result = 0u;
    [loop] for (uint b = 0; b < SolidBoxCount; b++)
    {
        float4 hw = SolidBoxHalf[b];
        float3 he = hw.xyz;
        float4x4 w2l = SolidBoxWorldToLocal[b];
        float3 lp = mul(w2l, float4(p, 1.0)).xyz;
        float3 d = he - abs(lp);
        if (d.x <= 0.0 || d.y <= 0.0 || d.z <= 0.0) continue;

        float3 ln = float3(0, 0, 0);
        if (d.x < d.y && d.x < d.z) { float s = lp.x >= 0.0 ? 1.0 : -1.0; ln.x = s; lp.x = s * he.x; }
        else if (d.y < d.z)         { float s = lp.y >= 0.0 ? 1.0 : -1.0; ln.y = s; lp.y = s * he.y; }
        else                        { float s = lp.z >= 0.0 ? 1.0 : -1.0; ln.z = s; lp.z = s * he.z; }

        float4x4 l2w = SolidBoxLocalToWorld[b];
        p = mul(l2w, float4(lp, 1.0)).xyz;
        float3 n = normalize(mul(l2w, float4(ln, 0.0)).xyz);   // 回転+平行移動のみの行列なので方向は w=0 で回る
        float vn = dot(v, n);
        if (vn < 0.0)
        {
            float3 vt = v - vn * n;
            v = vt * (1.0 - BoundsFriction) - vn * n * BoundsRestitution;
        }
        // 15 度勾配の上面でも n.y ≒ 0.97 なので 0.5 で十分拾える。
        bool topFace = n.y > 0.5;
        uint hit = (topFace && hw.w > 0.5) ? 2u : 1u;
        result = max(result, hit);
    }
    return result;
}

// ギミックの箱との衝突を、Finalize の後に独立したパスとして解決する。
// Finalize の中に入れると（既に巨大なカーネルなので）FXC がクラッシュした。
// 対象は「壺の外にいる粒子」だけ: 壺の中の液体は箱に触れない（壺は箱の上に
// 浮いているので幾何的に重ならない）。Escaped(3) が定着可能な上面に着いたら、
// 地面と同じくその場の水たまりとして定着する（Ground 集計・GroundLifetime）。
[numthreads(THREADS, 1, 1)]
void SolidBoxCollide(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount || SolidBoxCount == 0) return;
    uint state = RetiredFlags[i];
    if (state == 1u || state == 2u) return;   // 消滅済み / 定着済みは動かさない
    float3 p = Positions[i];
    float3 v = Velocities[i];
    uint hit = ResolveSolidBoxes(p, v);
    if (hit == 0u) return;
    if (hit == 2u && state == 3u)
    {
        Positions[i] = p;
        Velocities[i] = float3(0, 0, 0);
        RetiredFlags[i] = 2u;
        return;
    }
    // 通常粒子（跳ねて一時的に外へ出ただけ）や側面接触は押し出すだけ。
    Positions[i] = p;
    Velocities[i] = v;
}

// 世界境界（グリッド外周 = 数値的な最終防壁）と、地面、壺内部からの一時貫通の回収。
// 壺の壁そのものは Boundary Particle が担当する (§10)。ここは例外処理と地面。
[numthreads(THREADS, 1, 1)]
void Finalize(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;

    // --- Retired (§16/§20) ---
    // 地面に GroundLifetime 以上留まった粒子は「回収不可能」として世界から取り除く。
    // 領域外の待避先へ移し、速度を 0 にする。CellCoord が領域外になるので近傍探索にも
    // 入らず、密度場にも寄与しない（＝物理的にも視覚的にも存在しなくなる）。
    // Mass は消えるのではなく RetiredMass へ移る。収支は常に一定 (§16)。
    uint state = RetiredFlags[i];
    if (state == 1u)
    {
        // 安価なハッシュで粒子ごと・フレームごとに違う場所へ散らす(同じ粒子が毎回
        // 同じ点から復活すると縦の筋が見えてしまう)。
        uint h = i * 2654435761u + FrameSeed * 40503u;
        // 流量の絞り (SpawnChance)。1 なら従来どおり在庫を全部その場で戻す(滝の水源)。
        // 壺の補充では 1 未満にして、毎フレーム抽選で少しずつ戻す = 注がれて増えていく。
        // 抽選に外れた粒子は Retired のまま待避先へ置き、次フレームに引き直す。
        uint gh = h; gh ^= gh >> 16; gh *= 2246822519u; gh ^= gh >> 13;
        bool spawnNow = SpawnBoxActive() && frac((float)(gh & 0xFFFFu) / 65536.0) < SpawnChance;
        if (spawnNow)
        {
            h ^= h >> 13; h *= 60493u; h ^= h >> 15;
            float rx = frac((float)(h & 0xFFFFu) / 65536.0);
            h = h * 747796405u + 2891336453u;
            float ry = frac((float)(h & 0xFFFFu) / 65536.0);
            h = h * 747796405u + 2891336453u;
            float rz = frac((float)(h & 0xFFFFu) / 65536.0);
            Positions[i] = SpawnBoxMin + float3(rx, ry, rz) * SpawnBoxSize;
            Velocities[i] = SpawnVelocity;
            RetiredFlags[i] = 0u;
            Ages[i] = 0.0;
            return;
        }
        Positions[i] = RetiredPark;
        Velocities[i] = float3(0, 0, 0);
        return;
    }
    if (state == 2u)
    {
        // 領域外に取り残された水たまり。その場で凍結する。
        // グリッド外なので近傍探索にも入らず、他の粒子に干渉しない。
        Velocities[i] = float3(0, 0, 0);
        // 寿命だけは進める。GroundLifetime を過ぎたら Retired へ移す。
        if (GroundLifetime > 0.0)
        {
            float a2 = Ages[i] + DeltaTime;
            Ages[i] = a2;
            if (a2 >= GroundLifetime) RetiredFlags[i] = 1u;
        }
        return;
    }

    float3 p = PredictedPositions[i];
    float3 v = Velocities[i];
    if (any(isnan(p)) || any(isinf(p))) { p = clamp(Positions[i], BoundsMin, BoundsMax); v = float3(0, 0, 0); }
    float3 before = p;

    if (state == 3u)
    {
        // 壺のふちを越えた液体。壁とも他の粒子とも相互作用せず、重力で落ちるだけ。
        // 地面に着いたらその場に残す。
        if (p.y <= GroundY + GroundBandHeight)
        {
            // 地面にぴったり (y = GroundY) 揃えると、全粒子が完全な同一平面に並び、
            // 密度場が厚みゼロの板になって等値面に線状のノイズが出る。
            // 実際の粒子は床の上に「乗る」ので、中心は半径ぶん上にある。
            p.y = max(p.y, GroundY + GroundBandHeight * 0.35);
            Positions[i] = p;
            Velocities[i] = float3(0, 0, 0);
            // 猶予中 (ジャンプ中〜着地のパリー判定まで) は Escaped のまま置いておく。
            // 2u にすると凍結して回収の対象から外れ、踏切でこぼれた分が二度と戻らない。
            if (SpillGrace < 0.5) RetiredFlags[i] = 2u;
            return;
        }
        // ギミックの箱との衝突は SolidBoxCollide カーネルが Finalize の後に行う
        // （この巨大カーネルに足すと FXC がクラッシュするため分離した）。
        // 壺が動いて実体が Escaped 粒子を飲み込むことがある（ジャンプで壺が上がり、
        // 落ちてくる液体に胴がぶつかる）。そのままだと壺の中を素通りするので、
        // 外周のすぐ外へ押し出す。こぼれた液体が壺の外側を伝って落ちる形になる。
        if (SafetyEnabled != 0)
        {
            float3 lpX = mul(WorldToPotSafety, float4(p, 1.0)).xyz;
            if (lpX.y >= PotMeshMinY && lpX.y <= PotRimY)
            {
                float rX = length(lpX.xz);
                float outR = PotOuterAt(lpX.y);
                bool inCavity = (lpX.y >= PotFloorY) && (rX <= PotRadiusAt(clamp(lpX.y, PotFloorY, PotRimY)));
                if (!inCavity && rX <= outR && rX > 1e-4)
                {
                    lpX.xz *= (outR + WallTolerance) / rX;
                    p = mul(PotToWorldSafety, float4(lpX, 1.0)).xyz;
                }
            }
        }
        if (p.y < BoundsMin.y) p.y = BoundsMin.y;
        Positions[i] = p;
        Velocities[i] = v;
        return;
    }

    // 地面 (§9 Collision)。Overflow した液体はここへ落ちる。
    // 滝専用: 平らな1枚のGroundY面ではなく、実測したTerrain断面(SlopeProfileBuf)に沿って
    // 衝突・反射させる(崖に沿って流れ落ちる見た目にするため)。SlopeProfileBufが未設定
    // (要素2、フォールバック)の通常のポーション運搬物理では、下のSlopeProfileCount>2判定が
    // falseになり、従来のBoundsRestitution/BoundsFrictionによる平らなGroundY判定と完全に
    // 同じ挙動になる(SlopeRestitution/SlopeFrictionは滝のみでしか使われない)。
    float slopeY = max(GroundY, SlopeHeightAt(p.z));
    if (p.y < slopeY)
    {
        if (SlopeProfileCount > 2)
        {
            // 有限差分で局所法線を推定 (Y-Z 平面内のみ)。
            const float dz = 0.4;
            float hBack  = SlopeHeightAt(p.z - dz);   // より奥(z がより負) = 高い側
            float hFront = SlopeHeightAt(p.z + dz);   // より手前 = 低い側
            float slope = (hBack - hFront) / (2.0 * dz);
            // n=(0,1,+slope): h(z)がzの増加とともに下る(池へ向かう)面の外向き法線は+Z側へ傾く。
            float3 n = normalize(float3(0.0, 1.0, slope));

            // 完全なハードスナップではなく部分補正にし、PBFの圧力/慣性が表面形状を
            // 支配できるようにする(でないと岩に張り付いた剛体シェルのように見える)。
            uint jh = i * 2654435761u + FrameSeed * 97531u;
            jh ^= jh >> 13; jh *= 60493u; jh ^= jh >> 15;
            float jitter = (frac((float)(jh & 0xFFFFu) / 65536.0) - 0.5) * 0.6;
            float targetY = slopeY + jitter;

            const float correctionStrength = 0.35;
            p.y = lerp(p.y, targetY, correctionStrength);

            float vn = dot(v, n);
            if (vn < 0.0) v -= (1.0 + SlopeRestitution) * vn * n;
            v *= (1.0 - SlopeFriction);
        }
        else
        {
            // 既存のポーション運搬物理と完全に同じ、平らなGroundY面での反射。
            p.y = slopeY;
            if (v.y < 0.0) v.y = -v.y * BoundsRestitution;
            v.xz *= (1.0 - BoundsFriction);
        }
    }

    // ギミックの箱との衝突は SolidBoxCollide カーネル (Finalize の後) が担当する。

    // 領域の水平端に達した粒子の扱い。
    //
    // 水平方向のクランプはかけない。かけると、ゴブリンが歩いて領域が動いたとき、
    // 置いてきたはずの液体が見えない壁に沿って引きずられて一緒に付いてくる。
    //
    // 代わりに:
    //  * 地面に着いていたら **その場に置いていく (Settled)**。水たまりは残ってほしい。
    //  * まだ空中なら **そのまま落とす**。近傍探索には入らないので他の粒子には
    //    干渉しないが、重力と地面 Collision は効くので、ちゃんと落ちて着地する。
    //    ここで消してしまうと、こぼれた液体が地面に着く前に空中で消える
    //    （実測: ゴブリンが歩くと Ground が常に 0 で、全部 Retired になっていた）。
    bool outsideHoriz = p.x <= BoundsMin.x || p.x >= BoundsMax.x
                     || p.z <= BoundsMin.z || p.z >= BoundsMax.z;
    if (outsideHoriz && p.y <= GroundY + GroundBandHeight * 2.0)
    {
        RetiredFlags[i] = 2u;
        Positions[i] = p;
        Velocities[i] = float3(0, 0, 0);
        return;
    }

    // 縦方向だけはクランプする（領域の底は地面より下にある）。
    if (p.y < BoundsMin.y) { p.y = BoundsMin.y; if (v.y < 0.0) v.y = -v.y * BoundsRestitution; }
    if (p.y > BoundsMax.y) { p.y = BoundsMax.y; if (v.y > 0.0) v.y = -v.y * BoundsRestitution; }
    if (!outsideHoriz)
    {
        [unroll] for (int a = 0; a < 3; a += 2)
        {
            if (p[a] < BoundsMin[a]) { p[a] = BoundsMin[a]; if (v[a] < 0.0) v[a] = -v[a] * BoundsRestitution; }
            if (p[a] > BoundsMax[a]) { p[a] = BoundsMax[a]; if (v[a] > 0.0) v[a] = -v[a] * BoundsRestitution; }
        }
    }
    if (any(abs(p - before) > 1e-9)) v *= (1.0 - BoundsFriction);

    // --- 壺のふちを越えたら Escaped にする（ユーザー指定の挙動） ---
    // 越えた液体は戻さない。跳ね上がって口へ落ち戻ると、派手にこぼれているのに
    // 残量が減らない、という状態になるため。
    if (EscapeEnabled != 0 && SafetyEnabled != 0)
    {
        // 判定は「リム面より上か」ではなく **「壺の内側から出たか」**。
        // リム面だけで見ると、満タンの壺が待機モーションで揺れただけで
        // 中身が次々に逃げてしまう（実測: 立っているだけで 6 秒で半分失われた）。
        // 横から縁を越えて流れ出す液体も、上へ跳ねた液体も、
        // どちらも「壺の内側の形から出た」という同じ条件で拾える。
        float3 lpE = mul(WorldToPotSafety, float4(p, 1.0)).xyz;
        float rE = length(lpE.xz);
        float rIn = PotRadiusAt(clamp(lpE.y, PotFloorY, PotRimY));
        // 液体が壺から出られるのは **開口部（リム）だけ**。
        //  * リム付近より上にいて、かつ壺の内側半径より外 → こぼれた
        //  * 壺の口の真上へ跳ね上がっただけ（半径が内側） → 戻ってよい（ユーザー指示）
        //  * 壺の胴や底で壁の外へはみ出した → こぼれではなく「壁の貫通」。
        //    これを脱出扱いにすると、ジャンプの着地で底へ押し付けられた液体が
        //    一斉に失われる（実測: ジャンプでほぼ全量が消えた）。
        //    壁の貫通は SafetyCorrection の担当。
        // **壺の外形より外に出たときだけ**脱出とする。
        // 内側半径だけで判定していたとき、壁の厚みの中（内周と外周の間）にいる粒子まで
        // 脱出扱いになっていた。脱出した粒子は壁とも床とも相互作用しないので、
        // そのまま壺の胴と底を素通りして落ち、ジャンプ時に「壺の下から液体が出る」
        // 見え方になっていた（実測: 着地時に 259 粒子が壺の実体の中を通過）。
        // 外形より外にいる粒子は、そもそも壺の実体と重ならないのでこの問題が起きない。
        bool nearOrAboveLip = lpE.y > PotRimY - EscapeMargin;
        bool outsideRadius  = rE > max(rIn + WallTolerance, PotOuterAt(lpE.y)) + EscapeMargin;
        // 追補 35 (2026-08-22 バグ報告「こぼれた見た目とゲージの残量が一致しない」):
        // 「リム付近より上」だけを脱出の入口にしていたため、**リムを越えたあと壺の胴に
        // 沿って落ちた液体** がリム高さを外れた瞬間に判定対象から抜け、着地して Ground に
        // 分類されるまで「まだ壺のもの (Recoverable)」として残量に数えられていた。
        // 見た目には既に壺の外を落ちているのにゲージが減らない状態。
        // 壺の **底より下** にいて、かつ外形より外にいる粒子は、壺の内側にはあり得ない
        // (真下は外形の内側なので、底の貫通と取り違える心配もない) ので脱出として拾う。
        bool belowPotFloor = lpE.y < PotFloorY - EscapeMargin;
        // 2026-08-23 バグ報告「壺が完全に倒れているのに残量が 1 秒 1% ずつしか減らない」。
        // 上の 2 条件は **壺が立っている前提** で書かれている。壺が横倒しになると、
        // 口から流れ出た液滴は壺ローカルでは「リムより上」でも「底より下」でもなく
        // 横へ falling するので、どちらの入口にも掛からず脱出として拾えない。
        // 結果、地面に着いて Ground になるまで「まだ壺の中身」として残量に数え続け、
        // ゲージがだらだら減る状態になっていた (実測: air 1673 に対し escaped 0)。
        // 壺の外形から EscapeFarMargin 以上離れた粒子は、壁厚の内側にいる貫通粒子とは
        // 明確に区別できるので、姿勢によらず脱出として拾う。
        bool farOutside = rE > max(rIn + WallTolerance, PotOuterAt(lpE.y)) + EscapeFarMargin;
        bool outsidePot = ((nearOrAboveLip || belowPotFloor) && outsideRadius) || farOutside;
        if (outsidePot)
        {
            RetiredFlags[i] = 3u;
            Positions[i] = p;
            Velocities[i] = v;
            return;
        }
    }

    // --- SafetyCorrection (§10): 壺の壁/床を突き抜けた粒子だけを引き戻す ---
    // このカーネルは ComputeVelocity より後に走るので、ここでの位置変更は
    // v = (p' - p) / dt に混入しない。前回のバグ（クランプの位置差が速度に化ける）は
    // 構造的に再発しない。
    if (SafetyEnabled != 0)
    {
        float3 lp = mul(WorldToPotSafety, float4(p, 1.0)).xyz;
        bool fixedUp = false;

        // リムより上では絶対に補正しない。ここで補正すると、リムを越えようとしている
        // 粒子を内側へ引き戻すことになり、SafetyCorrection が「液体を容器に留める堰」
        // として常態化する（追加修正2 が禁止している状態）。
        //
        // リムより下は「床」と「壁」を **別々の else if にしない**。
        // 以前は
        //     if (床より下 && 半径 < PotMaxRadius) 押し上げる
        //     else if (床より上) 半径を内側へ寄せる
        // という形だったため、**床より下かつ PotMaxRadius より外**——つまり
        // 床と壁が出会う角——がどちらの枝にも入らず、一切補正されなかった。
        // ジャンプの上向き加速で液体が床へ押し付けられると、まさにこの角から
        // 外へ搾り出され、壺の底のあたりから放射状に噴き出して見えていた。
        if (lp.y <= SafetyTopY && lp.y > PotFloorY - PotMaxRadius)
        {
            float r = length(lp.xz);
            // 壺の実体の中（＝物理的に液体が存在し得ない場所）だけを戻す。
            // 外形より外に出たものは「こぼれた液体」なので触らない。
            float outR = max(PotOuterAt(lp.y), PotMaxRadius) + WallTolerance;
            if (r <= outR)
            {
                // 1. 床より下なら床の上へ
                if (lp.y < PotFloorY + SafetyMargin)
                {
                    lp.y = PotFloorY + SafetyMargin;
                    fixedUp = true;
                }
                // 2. そのうえで内側半径に収める
                r = length(lp.xz);
                float rIn = PotRadiusAt(clamp(lp.y, PotFloorY, PotRimY));
                if (r > rIn + SafetyMargin)
                {
                    float2 n = r > 1e-6 ? lp.xz / r : float2(1, 0);
                    lp.xz = n * (rIn - SafetyMargin);
                    fixedUp = true;
                }
            }
        }

        if (fixedUp)
        {
            p = mul(PotToWorldSafety, float4(lp, 1.0)).xyz;
            uint dummy;
            InterlockedAdd(SafetyCounters[0], 1, dummy);
        }
    }

    // 地面に留まっている時間を数える。地面から離れたらリセットする。
    if (GroundLifetime > 0.0)
    {
        if (p.y <= GroundY + GroundBandHeight)
        {
            // 滝(SpawnBoxActive)のみ: 全粒子が同じGroundLifetimeで一斉にRetired/再スポーン
            // すると、水源からの湧き出しが同期して断続的な脈動に見える。粒子スロットごとに
            // 寿命を±40%ばらけさせて再スポーンのタイミングを分散させる。壺の水たまりの
            // 消滅タイミングは従来通り厳密にGroundLifetimeとする(挙動を変えないため)。
            float lifetimeJitter = 1.0;
            if (SpawnBoxActive())
            {
                uint jh = i * 2654435761u; jh ^= jh >> 15; jh *= 2246822519u; jh ^= jh >> 13;
                lifetimeJitter = 0.6 + 0.8 * frac((float)(jh & 0xFFFFu) / 65536.0); // 0.6x .. 1.4x
            }
            float age = Ages[i] + DeltaTime;
            Ages[i] = age;
            if (age >= GroundLifetime * lifetimeJitter) RetiredFlags[i] = 1;
        }
        else
        {
            Ages[i] = 0.0;
        }
    }

    Positions[i] = p;
    Velocities[i] = v;
}

// ============================================================================
// 領域分類 / Overflow 判定 (§11, §14, 追加修正1)
//
// **このカーネルは観測しかしない。** 書き込むのは RegionFlags と RegionCounters だけで、
// 位置・速度は SRV (PositionsIn) としてしか渡されていない。したがって RimOpening 判定が
// 液体を外へ押し出すことはコード上不可能である。液体が壺の外へ出る原因は、
// World Gravity / 慣性 / PBF 圧力 / 粘性 / 表面張力 / Moving Boundary だけ。
//
// Rim Opening を「通過した」粒子だけを正常な Overflow とみなす。壁や底から直接外へ
// 出た粒子は Boundary Failure として別に数え、Overflow には計上しない。
// ============================================================================
#define REGION_RIM     1u
#define REGION_AIR     2u
#define REGION_GROUND  3u
#define REGION_RETIRED 4u
#define FLAG_PASSED_RIM 8u
#define FLAG_EVER_OUT  16u    // 一度でも壺の外へ出た。戻っても消さない（重複計上を防ぐラッチ）

[numthreads(THREADS, 1, 1)]
void ClassifyRegions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= FluidCount) return;

    // §3 CFL 用の実測最大速さ。次フレームのサブステップ数を決めるのに使う。
    // ここは既に全粒子を 1 回なめているので、追加のディスパッチは要らない。
    // CFL は相対運動 (壁と流体の相互貫通) を守るための制約なので、実測も
    // SpeedClampRef と同じゲートで容器基準の相対速度にする (2026-08-15)。
    // 世界基準のままだと、壺ごと自由落下しているだけ (相対運動ほぼ 0) でも
    // 9 m/s と報告され、サブステップ数だけが無駄に跳ね上がる。容器の動き自体が
    // 要求するサブステップ数は FluidCore.cs 側の containerSpeed 項が別途見ている。
    // 2026-08-21: 逸脱粒子 (RetiredFlags != 0 = Escaped/Settled/Retired) は計測から除外する。
    // これらは壁とも他の粒子とも相互作用せず (kCount がソートから外す)、地面/斜面は
    // 解析平面との毎サブステップ判定 (GroundBandHeight がトンネリングを防ぐ) なので、
    // CFL でカバーする必要が無い。従来は数滴のこぼれの自由落下 (クランプ 5 m/s) が
    // 計測を占有し、壺内が完全に静止していてもサブステップが 12 に張り付いていた
    // (= ソルバ費用が常時 2 倍)。
    if (RetiredFlagsIn[i] == 0u)
    {
        uint sp = (uint)(length(VelocitiesIn[i] - SpeedClampRef(PositionsIn[i])) * 1000.0);
        uint old;
        InterlockedMax(RegionCounters[7], sp, old);
    }

    float3 p = PositionsIn[i];
    uint prev = RegionFlags[i];
    uint prevRegion = prev & 7u;
    bool passedRim = (prev & FLAG_PASSED_RIM) != 0u;
    bool everOut   = (prev & FLAG_EVER_OUT) != 0u;

    uint region;
    uint stateIn = RetiredFlagsIn[i];
    if (stateIn != 0u)
    {
        // 1 = 消滅済み（待避先にいる）/ 2 = 領域外に取り残された水たまり。
        // 後者は「地面にある回収可能な液体」なので Ground として数える (§16)。
        uint d2;
        uint reg = (stateIn == 2u) ? REGION_GROUND
                 : (stateIn == 3u) ? REGION_AIR
                 : REGION_RETIRED;
        InterlockedAdd(RegionCounters[reg], 1, d2);
        // Escaped（もう壺へ戻らない落下中の液体）だけを別に数える。
        // RegionFlags の領域値は `& 7u` でマスクして使う箇所があるので 8 番は使えない。
        // 領域は REGION_AIR のままにして、カウンタだけ分ける。
        //
        // これが無いと「跳ね上がっただけで戻ってくる液体」と「こぼれて落下中の液体」が
        // どちらも Airborne に混ざり、残量ゲージが揺れの最中に大きく落ち込む
        // （実測: 実損失 3.3% の瞬間にゲージが 0.998 -> 0.598）。
        if (stateIn == 3u) InterlockedAdd(RegionCounters[8], 1, d2);
        RegionFlags[i] = reg | (prev & (FLAG_PASSED_RIM | FLAG_EVER_OUT));
        return;
    }
    if (p.y <= GroundY + GroundBandHeight)
    {
        region = REGION_GROUND;
    }
    else
    {
        float3 lp = mul(WorldToPotSafety, float4(p, 1.0)).xyz;
        float r = length(lp.xz);

        // 下限は床ちょうどではなく少し下まで見る。着地の衝撃で液体は一瞬 床を
        // 突き抜けるが、それは「壺の外」ではない（SafetyCorrection が押し戻す）。
        // 床ちょうどで切ると、ジャンプの着地でゲージが一瞬ゼロまで落ちる
        // （実測: 着地の瞬間だけ PotionVolume が 0.99 -> 0.03 になった）。
        if (lp.y >= PotFloorY - FloorTolerance && lp.y <= PotRimY && r <= PotRadiusAt(lp.y) + WallTolerance)
        {
            region = REGION_INSIDE;
            passedRim = false;                     // 中に戻ったら通過履歴はリセット
        }
        else if (lp.y > PotRimY && lp.y <= PotRimY + RimOpeningHeight && r <= PotRimR)
        {
            region = REGION_RIM;                   // ここが Open Boundary の「出口」
            passedRim = true;                      // 通過を観測しただけ。押し出してはいない
        }
        else
        {
            region = REGION_AIR;
        }
    }

    uint dummy;
    InterlockedAdd(RegionCounters[region], 1, dummy);

    // 遷移の判定: Inside から出た瞬間だけを見る。
    // 液面付近の粒子は Inside と RimOpening を何度も往復するので、遷移をそのまま数えると
    // 「溢れた量」としては読めない。粒子ごとに FLAG_EVER_OUT でラッチし、
    // **初めて外へ出たときだけ**数える。
    //
    // 正常/貫通の判別は「RimOpening 領域を通ったか」ではなく
    // **リム面(local y = RimY)を越えたか**で行う。RimOpening は半径 PotRimR の
    // 細い筒なので、勢いよく縁を越えて外へ広がる粒子は 1 フレームの間に筒の外へ出てしまい、
    // 正常な Overflow が「貫通」として誤計上されていた（幾何判定では壁抜け 0 個なのに
    // penetrationEvents が 988 になる、という食い違いが実測で出た）。
    // 壁を抜けたなら local y は RimY 以下のままのはずなので、この判定で過不足なく分かれる。
    if (prevRegion == REGION_INSIDE && region != REGION_INSIDE && !everOut)
    {
        everOut = true;
        float3 lpNow = mul(WorldToPotSafety, float4(p, 1.0)).xyz;
        if (lpNow.y > PotRimY || region == REGION_RIM || passedRim)
            InterlockedAdd(RegionCounters[5], 1, dummy);   // 正常な Overflow
        else
            InterlockedAdd(RegionCounters[6], 1, dummy);   // 壁/床の貫通 = 異常
    }

    RegionFlags[i] = region | (passedRim ? FLAG_PASSED_RIM : 0u) | (everOut ? FLAG_EVER_OUT : 0u);
}
