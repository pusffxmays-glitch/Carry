// ============================================================================================
// FluidSurface.compute -- Particle -> 3D Density Field (Sparse Brick Pool) -> Iso Surface
//
// FLUID_DESIGN.md §11 / §12 / §13 / §14 に対応。
//
// ORIGIN / LICENCE: first-party code。等値面抽出は立方体を 6 個の四面体へ分解する方式で、
// 256 ケースの三角形テーブルのような「データ」を一切使わない。全ての三角形分割は
// 四面体 1 個あたり「内側の頂点が何個か」から一次原理で導出される。したがって外部の
// テーブルを持ち込む必要がなく、ライセンス上の依存も、記憶から書き起こしたテーブルに
// 誤りが混入する危険も無い。生成される等値面は標準 Marching Cubes と同じもので、
// watertight である（隣接四面体は共有面上で同じ辺補間点を必ず生成するため）。
//
// 設計上の要点:
//  * 粒子位置を直接メッシュ化しない。Kernel で 3D 密度場へ広げてから等値面を取る (§11)。
//  * Atomic 蓄積は uint 固定小数、Visual 用は float。両者を分離する (§11/修正3)。
//  * 壺内部・Overflow・Ground Fluid を区別しない。全部この 1 つの場に入る (§12/修正7)。
//
// ---- Sparse Brick Pool (§14) ----
//
// 以前は「ドメイン全体ぶんの密な 3D テクスチャ」を持ち、計算する範囲だけを Brick で
// 絞っていた。これだとメモリがドメインの体積に比例するので、密度場を壺の周り
// 半径 1.8m 程度の箱にしか広げられず、**こぼした液体が少し離れると描画されなくなり、
// 箱の縁で等値面がスパッと切れて四角い境界線として見えていた**。
//
// この版はメモリを **実際に液体がある Brick の数** に比例させる。
//  * ドメインは world 固定の大きな箱（部屋全体を覆える）
//  * Brick(8^3 voxel) ごとに「プールのどのスロットを使うか」を毎フレーム割り当てる
//  * 割り当てが無い Brick は密度 0 として読む
//
// 場そのものは全ドメインで 1 つ・連続。Brick は「同じ 1 つの場のどこを実体化するか」を
// 決めるだけで、別の場を作らない。したがって Brick 境界に継ぎ目は発生しない。
// ============================================================================================

#pragma kernel ResetSlots
#pragma kernel ClearSlots
#pragma kernel MarkAndAllocate
#pragma kernel WriteBrickArgs
#pragma kernel ClearPool
#pragma kernel SplatDensity
#pragma kernel DecodeDensity
#pragma kernel BlurDensity
#pragma kernel MaskSolid
#pragma kernel BuildSurface
#pragma kernel WriteDrawArgs
#pragma kernel ComputeVertexNormals

#define THREADS 256
#define BRICK 8              // 1 Brick = 8^3 voxel
#define BRICK_VOXELS 512     // 8*8*8

static const uint INVALID_SLOT = 0xFFFFFFFFu;
static const uint SLOT_RESERVED = 0xFFFFFFFEu;   // 割り当て中（CAS の勝者が確定値を書くまで）

uint3 BrickDims;
uint  BrickTotal;
int   MarkRadiusVoxels;      // 粒子からこの voxel 半径に触れる Brick を実体化する
uint  PoolCapacity;          // プールが持てる Brick 数
uint  ClearStride;           // ResetSlots (起動時のみ) の 2D タイル幅

RWStructuredBuffer<uint>  BrickSlot;       // Brick -> プールのスロット (INVALID_SLOT = 未割当)
StructuredBuffer<uint>    BrickSlotIn;     // 読み取り専用エイリアス
RWStructuredBuffer<uint>  ActiveBricksRW;  // スロット -> Brick
StructuredBuffer<uint>    ActiveBricks;
RWStructuredBuffer<uint>  AllocCounter;    // [0]=割当数 [1]=容量超過数

RWStructuredBuffer<uint>  PoolAccum;       // 固定小数。atomic 用
RWStructuredBuffer<float> PoolOut;         // 書き込み先 (A or B)
RWStructuredBuffer<float> PoolOutB;        // ClearPool 用の 2 枚目
StructuredBuffer<float>   PoolSrc;         // 読み取り元

RWStructuredBuffer<uint>  BrickArgs;       // DispatchIndirect 用 (x,y,z)

StructuredBuffer<float3> Particles;
uint  ParticleCount;

uint3  VoxelDims;
float3 FieldOrigin;
float  VoxelSize;

// ---- 壺の実体で密度場を切り落とす ----
//
// 等値面は最外周の粒子から Splat 半径ぶん外側にふくらむ（実測 57.4mm）。
// 壺の壁の厚みはそれより薄い場所があるので、そのままだと液体が壺の側面を
// 突き抜けて描画され、走ると「ツボの外側にポーションがはみ出す」、
// ジャンプすると「壺の下のほうにはみ出す」という見え方になる。
// 壁の中に液体は存在し得ないので、密度場をここで 0 にする。
//
// 粒子側は問題ない（実測で内壁から最大 11.4mm しか出ていない）。直すのは描画側。
int      PotClipEnabled;
float4x4 WorldToPot;
StructuredBuffer<float> PotInnerBuf;   // FloorY..RimY を等分した内側半径
StructuredBuffer<float> PotOuterBuf;   // MeshMinY..MeshMaxY を等分した外周半径
uint  PotProfileCount;
float PotFloorY, PotRimY, PotMeshMinY, PotMeshMaxY;
float3 PotCentreWS;        // 早期棄却用（壺を包む球）
float PotClipRadiusWS;

RWStructuredBuffer<float> PoolMask;    // MaskSolid が書き換える先（PoolSrc と同じ実体）

float SplatRadius;          // 密度カーネル半径 (m)
// 追補 36: こぼれた液体 (RetiredFlags != 0) の描画半径倍率。
// 壺の中では粒子が重なり合うので合計密度で液面が決まるが、こぼれて孤立した粒子は
// 1 個が半径 0.48*SplatRadius の球として描かれ、実体積 (粒子間隔の立方) より大きく見える。
// そのため「少ししか減っていないのに大量にこぼれたように見える」= 残量ゲージと不一致になる。
// ここを絞ると、こぼれた見た目の量が実際の損失量に近づく。
float EscapedSplatScale;
StructuredBuffer<uint> ParticleStates;   // 0 = 壺のもの、それ以外 = こぼれた
// 2026-08-28「水玉分離」対策: 空中に飛び散った直後や巻き戻し中の粒は state=0 のまま
// なので、孤立していても半径 0.48*SplatRadius の球として描かれ「大きな水玉」に見える。
// シミュ側の密度 = 孤立度なので、密度が低い粒ほど描画半径を縮めて小さな液滴にする。
// 壺の液面の粒 (密度 ~0.5 rest) は縮めない下限を取ってあり、液面の見た目は変わらない。
StructuredBuffer<float> ParticleDensities;
float SplatRestDensity;      // シミュの基準密度
float IsolatedSplatScale;    // 完全に孤立した粒の描画半径倍率
float DensityScale;         // 固定小数のスケール
float IsoValue;
int3  BlurAxis;
float SurfaceNormalEps;

// ---- 出力（等値面） ----
struct SurfaceVertex
{
    float3 position;
    float3 normal;
};
// **AppendStructuredBuffer は使わない。**
// Append() は 1 要素ずつスロットを取るので、三角形 1 枚ぶんの 3 頂点を 3 回 Append すると
// 他スレッドの Append が間に割り込み、**別々の三角形の頂点が 1 枚に混ざる**。
// 結果、離れた点を結ぶ細長いスパイクや扇状の筋が出る。
// 三角形番号を 1 回の InterlockedAdd で取り、3 頂点を連続スロットへ直接書く。
RWStructuredBuffer<SurfaceVertex> SurfaceVertices;
RWStructuredBuffer<uint> SurfaceCounters;   // [0] = 容量超過で捨てた三角形数, [1] = 三角形数
RWStructuredBuffer<uint> DrawArgs;
uint MaxTriangles;

static const float PI = 3.14159265359;

float SplatKernel(float r2, float h)
{
    float h2 = h * h;
    if (r2 >= h2) return 0.0;
    float d = 1.0 - r2 / h2;
    return d * d * d;      // 正規化しない: IsoValue 側で吸収する
}

uint BrickIndex(uint3 b) { return b.x + b.y * BrickDims.x + b.z * BrickDims.x * BrickDims.y; }

uint3 BrickCoord(uint idx)
{
    uint xy = BrickDims.x * BrickDims.y;
    return uint3(idx % BrickDims.x, (idx / BrickDims.x) % BrickDims.y, idx / xy);
}

uint LocalIndex(uint3 v) { uint3 l = v & 7u; return l.x + l.y * 8u + l.z * 64u; }

// voxel -> プール上のアドレス。未割当なら INVALID_SLOT を返す。
uint PoolAddress(int3 v)
{
    if (any(v < 0) || any(v >= (int3)VoxelDims)) return INVALID_SLOT;
    uint slot = BrickSlotIn[BrickIndex((uint3)v >> 3u)];
    if (slot == INVALID_SLOT) return INVALID_SLOT;
    return slot * BRICK_VOXELS + LocalIndex((uint3)v);
}

// 密度場の読み取り。未割当の Brick は 0（そこに液体は無い）。
float ReadField(int3 v)
{
    uint a = PoolAddress(v);
    return (a == INVALID_SLOT) ? 0.0 : PoolSrc[a];
}

// --------------------------------------------------------------------------------------------
// 毎フレームの割り当て
//
// 割り当ては **粒子の数に比例** させる。ドメイン全体を毎フレーム走査すると、
// 描画範囲を広げた分だけコストが増えてしまい、「範囲を広げても軽い」という
// プール方式の利点が消える。
//
// 前フレームの消し残し対策（BrickResident）はプール方式では不要になった。
// 未割当の Brick は密度 0 として読まれ、割り当てた Brick は毎フレーム
// ClearPool で 0 にされるので、古い密度が残る経路が構造的に存在しない。
// --------------------------------------------------------------------------------------------

// 起動時に 1 度だけ。全 Brick を未割当にする。
[numthreads(THREADS, 1, 1)]
void ResetSlots(uint3 id : SV_DispatchThreadID)
{
    uint b = id.x + id.y * ClearStride;
    if (b >= BrickTotal) return;
    BrickSlot[b] = INVALID_SLOT;
}

// 毎フレームの先頭。**前フレームに使った Brick だけ**を未割当へ戻す。
// AllocCounter はまだ前フレームの値を保持している（リセットはこの後）。
[numthreads(64, 1, 1)]
void ClearSlots(uint3 id : SV_DispatchThreadID)
{
    uint n = min(AllocCounter[0], PoolCapacity);
    if (id.x >= n) return;
    BrickSlot[ActiveBricks[id.x]] = INVALID_SLOT;
}

// 粒子の影響が届く範囲の Brick へ、その場でスロットを配る。
//
// 範囲は **voxel 半径から導く**。以前は「粒子の Brick から Brick 単位で 2 個ぶん」
// という取り方をしていたが、それは 5x5x5 = 125 Brick で、実際に必要な範囲
// （Splat 半径 5 + Blur の到達 4 + Marching Cubes/法線 3 = 12 voxel = 1.5 Brick）の
// 4 倍以上あった。地面に散った液滴 1 粒ごとに 125 Brick を確保してしまい、
// 実測 2966 粒でプール 16384 を使い切って 1901 Brick が確保できず、
// 液体が虫食いになった。voxel 半径から取ると同じ条件で 3x3x3 前後に収まる。
//
// 「まだ誰も取っていなければ自分が取る」を CompareExchange で 1 回だけ成立させる。
// 敗者はそのまま抜ける（値を読む必要が無い。実際に読むのは次のディスパッチ以降）。
[numthreads(THREADS, 1, 1)]
void MarkAndAllocate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= ParticleCount) return;

    float3 local = (Particles[i] - FieldOrigin) / VoxelSize;
    int3 vc = (int3)floor(local);
    if (any(vc < 0) || any(vc >= (int3)VoxelDims)) return;   // ドメイン外の粒子は無視

    int r = MarkRadiusVoxels;
    int3 loV = max(vc - r, int3(0, 0, 0));
    int3 hiV = min(vc + r, (int3)VoxelDims - 1);
    int3 lo = loV >> 3;
    int3 hi = hiV >> 3;

    [loop] for (int z = lo.z; z <= hi.z; z++)
    [loop] for (int y = lo.y; y <= hi.y; y++)
    [loop] for (int x = lo.x; x <= hi.x; x++)
    {
        uint b = BrickIndex(uint3(x, y, z));
        uint prev;
        InterlockedCompareExchange(BrickSlot[b], INVALID_SLOT, SLOT_RESERVED, prev);
        if (prev != INVALID_SLOT) continue;      // 既に誰かが取った

        uint slot;
        InterlockedAdd(AllocCounter[0], 1, slot);
        if (slot >= PoolCapacity)
        {
            // 容量超過。ここを黙って無視すると液体が虫食いになるので数える (§36)。
            uint dummy;
            InterlockedAdd(AllocCounter[1], 1, dummy);
            BrickSlot[b] = INVALID_SLOT;
            continue;
        }
        ActiveBricksRW[slot] = b;
        BrickSlot[b] = slot;                     // ここで確定値を公開する
    }
}

// DispatchIndirect の引数。
//   [0..2] = Brick ごとのディスパッチ (有効 Brick 数, 1, 1)
//   [3..5] = 次フレームの ClearSlots 用 (ceil(有効 Brick 数 / 64), 1, 1)
[numthreads(1, 1, 1)]
void WriteBrickArgs(uint3 id : SV_DispatchThreadID)
{
    uint n = min(AllocCounter[0], PoolCapacity);
    BrickArgs[0] = n;
    BrickArgs[1] = 1u;
    BrickArgs[2] = 1u;
    BrickArgs[3] = (n + 63u) / 64u;
    BrickArgs[4] = 1u;
    BrickArgs[5] = 1u;
}

// 実体化した Brick だけを 0 クリアする。ドメイン全体は決して触らない (§14)。
[numthreads(BRICK, BRICK, BRICK)]
void ClearPool(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint slot = gid.x;
    uint addr = slot * BRICK_VOXELS + LocalIndex(gtid);
    PoolAccum[addr] = 0;
    PoolOut[addr] = 0;
    PoolOutB[addr] = 0;
}

// 粒子ごとに、影響半径内のボクセルへカーネル値を加算する。
// ボクセル側から粒子を集めるより、粒子が疎な領域で無駄が出ない。
[numthreads(THREADS, 1, 1)]
void SplatDensity(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= ParticleCount) return;

    float3 p = Particles[i];
    // 追補 36: こぼれた粒子は実体積に近い大きさで描く (宣言部の注記)。
    // 水玉分離対策 (宣言部の注記): state=0 でも孤立した粒は密度に応じて縮める。
    float scale;
    if (ParticleStates[i] != 0u)
        scale = EscapedSplatScale;
    else
    {
        float k = saturate((ParticleDensities[i] / max(SplatRestDensity, 1e-6) - 0.15) / 0.30);
        scale = lerp(IsolatedSplatScale, 1.0, k);
    }
    float h = SplatRadius * scale;
    float3 local = (p - FieldOrigin) / VoxelSize;
    int rad = (int)ceil(h / VoxelSize);

    int3 c0 = (int3)floor(local) - rad;
    int3 c1 = (int3)floor(local) + rad;
    c0 = max(c0, int3(0, 0, 0));
    c1 = min(c1, (int3)VoxelDims - 1);

    [loop] for (int z = c0.z; z <= c1.z; z++)
    [loop] for (int y = c0.y; y <= c1.y; y++)
    [loop] for (int x = c0.x; x <= c1.x; x++)
    {
        int3 v = int3(x, y, z);
        uint addr = PoolAddress(v);
        if (addr == INVALID_SLOT) continue;      // 容量超過などで実体が無い

        float3 vc = FieldOrigin + (float3(x, y, z) + 0.5) * VoxelSize;
        float3 d = vc - p;
        float w = SplatKernel(dot(d, d), h);
        if (w <= 0.0) continue;
        uint add = (uint)(w * DensityScale);
        if (add == 0) continue;
        uint old;
        InterlockedAdd(PoolAccum[addr], add, old);
    }
}

[numthreads(BRICK, BRICK, BRICK)]
void DecodeDensity(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint slot = gid.x;
    uint addr = slot * BRICK_VOXELS + LocalIndex(gtid);
    PoolOut[addr] = (float)PoolAccum[addr] / DensityScale;
}

// 分離ガウシアン (§14 Density Smoothing)。BlurAxis で軸を切り替えて 3 回まわす。
[numthreads(BRICK, BRICK, BRICK)]
void BlurDensity(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint slot = gid.x;
    int3 v = (int3)(BrickCoord(ActiveBricks[slot]) * BRICK + gtid);

    const float w0 = 0.38774, w1 = 0.24477, w2 = 0.06136;
    int3 a = BlurAxis;

    float sum = ReadField(v) * w0;
    sum += ReadField(v + a) * w1;
    sum += ReadField(v - a) * w1;
    sum += ReadField(v + a * 2) * w2;
    sum += ReadField(v - a * 2) * w2;

    PoolOut[slot * BRICK_VOXELS + LocalIndex(gtid)] = sum;
}

// StructuredBuffer を関数の引数に取るのは環境依存なので、2 本に分けて書く。
float PotInnerAt(float t)
{
    float f = saturate(t) * (float)(PotProfileCount - 1);
    uint i0 = (uint)f;
    uint i1 = min(i0 + 1, PotProfileCount - 1);
    return lerp(PotInnerBuf[i0], PotInnerBuf[i1], saturate(f - (float)i0));
}

float PotOuterAt(float t)
{
    float f = saturate(t) * (float)(PotProfileCount - 1);
    uint i0 = (uint)f;
    uint i1 = min(i0 + 1, PotProfileCount - 1);
    return lerp(PotOuterBuf[i0], PotOuterBuf[i1], saturate(f - (float)i0));
}

// 壺の実体（壁と底）にあたる voxel の密度を 0 にする。
// Blur の **後** に走らせること。前に置くと Blur が壁の中へ density を広げ直す。
[numthreads(BRICK, BRICK, BRICK)]
void MaskSolid(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    if (PotClipEnabled == 0) return;

    uint slot = gid.x;
    uint addr = slot * BRICK_VOXELS + LocalIndex(gtid);
    if (PoolMask[addr] <= 0.0) return;                    // もともと空

    int3 v = (int3)(BrickCoord(ActiveBricks[slot]) * BRICK + gtid);
    float3 wp = FieldOrigin + ((float3)v + 0.5) * VoxelSize;

    // 壺から遠い voxel（地面の水たまりなど）はここで抜ける。
    // 大半の voxel はこの 1 回の距離判定だけで済む。
    if (distance(wp, PotCentreWS) > PotClipRadiusWS) return;

    float3 lp = mul(WorldToPot, float4(wp, 1.0)).xyz;
    if (lp.y < PotMeshMinY || lp.y > PotRimY) return;     // 壺の上下の外側

    float r = length(lp.xz);
    float outerR = PotOuterAt((lp.y - PotMeshMinY) / max(1e-5, PotMeshMaxY - PotMeshMinY));
    if (r > outerR) return;                               // 壺の外。液だれ等はここで生き残る

    if (lp.y >= PotFloorY)
    {
        float innerR = PotInnerAt((lp.y - PotFloorY) / max(1e-5, PotRimY - PotFloorY));
        if (r <= innerR) return;                          // 壺の中身。液体があってよい
    }

    PoolMask[addr] = 0.0;                                 // 壁 or 底の内部
}

// --------------------------------------------------------------------------------------------
// 等値面抽出（四面体分解）
// --------------------------------------------------------------------------------------------
float SampleDensity(int3 c) { return ReadField(c); }

float3 VoxelPos(int3 c) { return FieldOrigin + (float3)c * VoxelSize; }

// 密度場を **トリリニア** で補間して勾配を取る。
// 最近傍で微分すると法線がボクセル単位で階段状になり、表面に鋭いスペキュラの筋として
// 現れる。等値面の頂点はボクセル境界上の任意の位置にあるので、そこで滑らかな法線を
// 得るには補間サンプリングが必要。
// プール方式ではハードウェアのフィルタリングが使えないので手で補間する。
//
// **8 タップは必ず [loop] で回す。** 展開すると ReadField の本体（境界判定 +
// Brick 索引 + バッファ読み）が 8 個に増え、それが FieldNormal で 6 倍、
// EmitTriangle で 3 倍、MarchTetra の分岐で 18 倍、立方体 1 個あたり 6 倍される。
// 実測で FXC が「Lost connection with shader compiler process」で落ちた。
// テクスチャ読みだった頃は 1 命令だったので展開しても問題にならなかった。
float SampleDensitySmooth(float3 wp)
{
    float3 f = (wp - FieldOrigin) / VoxelSize - 0.5;
    int3 b = (int3)floor(f);
    float3 t = f - (float3)b;

    float acc = 0.0;
    [loop] for (int k = 0; k < 8; k++)
    {
        int3 o = int3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        float3 w3 = lerp(1.0 - t, t, (float3)o);
        acc += ReadField(b + o) * (w3.x * w3.y * w3.z);
    }
    return acc;
}

float3 FieldNormal(float3 wp)
{
    float e = VoxelSize * SurfaceNormalEps;
    float3 g = float3(0, 0, 0);
    [loop] for (int a = 0; a < 3; a++)
    {
        float3 axis = float3(a == 0 ? 1 : 0, a == 1 ? 1 : 0, a == 2 ? 1 : 0);
        float3 d = axis * e;
        g += axis * (SampleDensitySmooth(wp + d) - SampleDensitySmooth(wp - d));
    }
    float len = length(g);
    // 等値面は密度が下がる向きが外側なので符号を反転する。
    return (len > 1e-8) ? -g / len : float3(0, 1, 0);
}

float3 EdgeLerp(float3 pa, float va, float3 pb, float vb)
{
    float t = (IsoValue - va) / (vb - va);
    return lerp(pa, pb, saturate(t));
}

void EmitTriangle(float3 a, float3 b, float3 c)
{
    // 容量チェックを書き込みの「前」に行う。超過分は捨ててカウンタに積むだけにする (§13/修正9)。
    uint tri;
    InterlockedAdd(SurfaceCounters[1], 1, tri);
    if (tri >= MaxTriangles)
    {
        uint dummy;
        InterlockedAdd(SurfaceCounters[0], 1, dummy);
        return;
    }

    // 三角形 1 枚は連続した 3 スロットに書く。ここが混ざらないことが重要。
    //
    // **法線はここでは計算しない。** BuildSurface の中では EmitTriangle が
    // 四面体 6 個 x 分岐 18 通り = 100 箇所以上に展開される。そこへ FieldNormal
    // （トリリニア 8 タップ x 中央差分 6 回 = ReadField 48 回）を埋め込むと
    // 命令数が桁違いになり、FXC が「Lost connection with shader compiler process」で
    // 落ちた。法線は出来上がった頂点に対して別カーネルで 1 回だけ計算する。
    // 同じ場を同じ式で読むので結果は変わらない。
    uint base = tri * 3u;
    SurfaceVertex v;
    v.normal = float3(0, 1, 0);
    v.position = a; SurfaceVertices[base + 0u] = v;
    v.position = b; SurfaceVertices[base + 1u] = v;
    v.position = c; SurfaceVertices[base + 2u] = v;
}

// 四面体 1 個の等値面。内側頂点の個数だけで分割が決まるのでテーブルが要らない。
void MarchTetra(float3 p0, float v0, float3 p1, float v1, float3 p2, float v2, float3 p3, float v3)
{
    uint mask = (v0 > IsoValue ? 1u : 0u) | (v1 > IsoValue ? 2u : 0u)
              | (v2 > IsoValue ? 4u : 0u) | (v3 > IsoValue ? 8u : 0u);
    if (mask == 0u || mask == 15u) return;

    // 内側の頂点が 1 個（または 3 個 = 反転）なら三角形 1 枚、2 個なら四辺形 = 三角形 2 枚。
    // 下の分岐は「どの頂点が単独で内側／外側か」を列挙しているだけで、外部データではない。
    switch (mask)
    {
        case 1u:  EmitTriangle(EdgeLerp(p0,v0,p1,v1), EdgeLerp(p0,v0,p2,v2), EdgeLerp(p0,v0,p3,v3)); break;
        case 14u: EmitTriangle(EdgeLerp(p0,v0,p1,v1), EdgeLerp(p0,v0,p3,v3), EdgeLerp(p0,v0,p2,v2)); break;

        case 2u:  EmitTriangle(EdgeLerp(p1,v1,p0,v0), EdgeLerp(p1,v1,p3,v3), EdgeLerp(p1,v1,p2,v2)); break;
        case 13u: EmitTriangle(EdgeLerp(p1,v1,p0,v0), EdgeLerp(p1,v1,p2,v2), EdgeLerp(p1,v1,p3,v3)); break;

        case 4u:  EmitTriangle(EdgeLerp(p2,v2,p0,v0), EdgeLerp(p2,v2,p1,v1), EdgeLerp(p2,v2,p3,v3)); break;
        case 11u: EmitTriangle(EdgeLerp(p2,v2,p0,v0), EdgeLerp(p2,v2,p3,v3), EdgeLerp(p2,v2,p1,v1)); break;

        case 8u:  EmitTriangle(EdgeLerp(p3,v3,p0,v0), EdgeLerp(p3,v3,p2,v2), EdgeLerp(p3,v3,p1,v1)); break;
        case 7u:  EmitTriangle(EdgeLerp(p3,v3,p0,v0), EdgeLerp(p3,v3,p1,v1), EdgeLerp(p3,v3,p2,v2)); break;

        case 3u:  { float3 a = EdgeLerp(p0,v0,p2,v2), b = EdgeLerp(p0,v0,p3,v3);
                    float3 c = EdgeLerp(p1,v1,p3,v3), d = EdgeLerp(p1,v1,p2,v2);
                    EmitTriangle(a, b, c); EmitTriangle(a, c, d); } break;
        case 12u: { float3 a = EdgeLerp(p0,v0,p2,v2), b = EdgeLerp(p0,v0,p3,v3);
                    float3 c = EdgeLerp(p1,v1,p3,v3), d = EdgeLerp(p1,v1,p2,v2);
                    EmitTriangle(a, c, b); EmitTriangle(a, d, c); } break;

        case 5u:  { float3 a = EdgeLerp(p0,v0,p1,v1), b = EdgeLerp(p0,v0,p3,v3);
                    float3 c = EdgeLerp(p2,v2,p3,v3), d = EdgeLerp(p2,v2,p1,v1);
                    EmitTriangle(a, b, c); EmitTriangle(a, c, d); } break;
        case 10u: { float3 a = EdgeLerp(p0,v0,p1,v1), b = EdgeLerp(p0,v0,p3,v3);
                    float3 c = EdgeLerp(p2,v2,p3,v3), d = EdgeLerp(p2,v2,p1,v1);
                    EmitTriangle(a, c, b); EmitTriangle(a, d, c); } break;

        case 9u:  { float3 a = EdgeLerp(p0,v0,p1,v1), b = EdgeLerp(p0,v0,p2,v2);
                    float3 c = EdgeLerp(p3,v3,p2,v2), d = EdgeLerp(p3,v3,p1,v1);
                    EmitTriangle(a, b, c); EmitTriangle(a, c, d); } break;
        case 6u:  { float3 a = EdgeLerp(p0,v0,p1,v1), b = EdgeLerp(p0,v0,p2,v2);
                    float3 c = EdgeLerp(p3,v3,p2,v2), d = EdgeLerp(p3,v3,p1,v1);
                    EmitTriangle(a, c, b); EmitTriangle(a, d, c); } break;
    }
}

[numthreads(BRICK, BRICK, BRICK)]
void BuildSurface(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id = BrickCoord(ActiveBricks[gid.x]) * BRICK + gtid;
    if (any(id + 1 >= VoxelDims)) return;
    int3 c = (int3)id;

    // 立方体の 8 隅
    float3 P[8];
    float  V[8];
    const int3 offs[8] =
    {
        int3(0,0,0), int3(1,0,0), int3(1,1,0), int3(0,1,0),
        int3(0,0,1), int3(1,0,1), int3(1,1,1), int3(0,1,1)
    };
    bool anyIn = false, anyOut = false;
    [unroll] for (int k = 0; k < 8; k++)
    {
        int3 cc = c + offs[k];
        P[k] = VoxelPos(cc);
        V[k] = SampleDensity(cc);
        if (V[k] > IsoValue) anyIn = true; else anyOut = true;
    }
    if (!anyIn || !anyOut) return;   // 完全に内側/外側のセルは等値面を含まない

    // 立方体を 6 個の四面体へ分解する。全ての四面体が対角 0-6 を共有するので、
    // 隣接セルとの間で辺の補間点が一致し、継ぎ目のない面になる。
    MarchTetra(P[0],V[0], P[1],V[1], P[2],V[2], P[6],V[6]);
    MarchTetra(P[0],V[0], P[2],V[2], P[3],V[3], P[6],V[6]);
    MarchTetra(P[0],V[0], P[3],V[3], P[7],V[7], P[6],V[6]);
    MarchTetra(P[0],V[0], P[7],V[7], P[4],V[4], P[6],V[6]);
    MarchTetra(P[0],V[0], P[4],V[4], P[5],V[5], P[6],V[6]);
    MarchTetra(P[0],V[0], P[5],V[5], P[1],V[1], P[6],V[6]);
}


// 描画引数を三角形カウンタから作る。AppendStructuredBuffer を使わなくなったので
// CopyCount は使えない。
[numthreads(1, 1, 1)]
void WriteDrawArgs(uint3 id : SV_DispatchThreadID)
{
    uint tris = min(SurfaceCounters[1], MaxTriangles);
    DrawArgs[0] = tris * 3u;   // 頂点数
    DrawArgs[1] = 1u;          // インスタンス数
    DrawArgs[2] = 0u;
    DrawArgs[3] = 0u;
    // [4..6] = ComputeVertexNormals の DispatchIndirect 引数
    DrawArgs[4] = (tris * 3u + THREADS - 1u) / THREADS;
    DrawArgs[5] = 1u;
    DrawArgs[6] = 1u;
    DrawArgs[7] = 0u;
}

// 出来上がった頂点に法線を付ける。等値面を作ったのと同じ密度場を同じ式で読む。
[numthreads(THREADS, 1, 1)]
void ComputeVertexNormals(uint3 id : SV_DispatchThreadID)
{
    uint count = min(SurfaceCounters[1], MaxTriangles) * 3u;
    if (id.x >= count) return;
    SurfaceVertices[id.x].normal = FieldNormal(SurfaceVertices[id.x].position);
}
